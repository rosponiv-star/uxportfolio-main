---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShare from '../assets/projects/justcook/cover-app.png';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  showFooterContact?: boolean;
  // Built but not meant to be found yet (unfinished case studies, Playground).
  noindex?: boolean;
  // Social preview (Open Graph / LinkedIn / chat apps); a 1200px JPEG is generated from it.
  image?: ImageMetadata;
}

const { title, description = site.description, bodyClass, showFooterContact = true, noindex = false, image } = Astro.props;
const share = await getImage({ src: image ?? defaultShare, width: 1200, format: 'jpeg', quality: 82 });
const shareUrl = new URL(share.src, Astro.site);
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — UX & Digital Product Designer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-light.png" type="image/png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/favicon-light.png" />
    <meta name="theme-color" content="#fdfdfc" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(share.attributes.height ?? 750)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareUrl} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer showContact={showFooterContact} />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

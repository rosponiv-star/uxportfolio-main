---
// Scroll-driven device scene. The section is tall; inside, a sticky stage keeps the phone
// centred while scrolling crossfades its screens (dissolve + slight zoom). Each screen
// gets half a viewport of scroll and a snap point, so the page settles on a screen.
//
// screens: solid colours for now; later { image } entries replace them with real UI.
// The device is drawn in CSS; a hand photo can be layered in `.ps__hand` when available.
interface Screen {
  color?: string;
  image?: string;
  label?: string;
}
interface Props {
  screens: Screen[];
  label?: string;
}
const { screens, label = 'Interface walkthrough' } = Astro.props;
const n = screens.length;
const pad = (i: number) => String(i).padStart(2, '0');
---

<section class="ps" style={`--n: ${n}`} aria-label={label} data-ps>
  <div class="ps__stage">
    <div class="ps__device" aria-hidden="true">
      <span class="ps__btn ps__btn--action"></span>
      <span class="ps__btn ps__btn--up"></span>
      <span class="ps__btn ps__btn--down"></span>
      <span class="ps__btn ps__btn--power"></span>
      <div class="ps__bezel">
        <div class="ps__screen">
          {
            screens.map((s, i) => (
              <div class="ps__shot" data-shot style={`${s.color ? `background:${s.color};` : ''}opacity:${i === 0 ? 1 : 0}`}>
                {s.image && <img src={s.image} alt="" />}
              </div>
            ))
          }
          <span class="ps__island"></span>
        </div>
      </div>
    </div>

    <div class="ps__progress label" aria-hidden="true">
      <span data-ps-count>01 / {pad(n)}</span>
      <span class="ps__bar"><i data-ps-bar></i></span>
    </div>
  </div>

  {screens.map((_, i) => <div class="ps__snap" style={`top: ${i * 50}svh`}></div>)}
</section>

<style>
  /* Height: one sticky viewport + half a viewport of scroll per screen change. */
  .ps {
    position: relative;
    height: calc(100svh + (var(--n) - 1) * 50svh);
    margin-top: var(--space-section);
  }

  .ps__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .ps__snap {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
    scroll-snap-align: start;
  }

  /* Device — iPhone-like, natural titanium frame */
  .ps__device {
    --h: min(78svh, 760px);
    position: relative;
    height: var(--h);
    aspect-ratio: 71.5 / 147.6;
    border-radius: calc(var(--h) * 0.105);
    background: #b9b5ae;
    padding: calc(var(--h) * 0.006);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.35),
      inset 0 0 0 2px rgb(0 0 0 / 0.12),
      0 calc(var(--h) * 0.06) calc(var(--h) * 0.09) calc(var(--h) * -0.04) rgb(30 28 24 / 0.35),
      0 calc(var(--h) * 0.015) calc(var(--h) * 0.03) rgb(30 28 24 / 0.12);
  }

  .ps__bezel {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--h) * 0.099);
    background: #0b0b0b;
    padding: calc(var(--h) * 0.011);
  }

  .ps__screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: calc(var(--h) * 0.088);
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }

  .ps__island {
    position: absolute;
    z-index: 50;
    top: calc(var(--h) * 0.016);
    left: 50%;
    width: calc(var(--h) * 0.083);
    height: calc(var(--h) * 0.025);
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }

  .ps__shot {
    position: absolute;
    inset: 0;
    will-change: opacity, transform;
  }

  .ps__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ps__btn {
    position: absolute;
    width: calc(var(--h) * 0.006);
    border-radius: 2px;
    background: #a9a59e;
  }

  .ps__btn--action { left: calc(var(--h) * -0.005); top: 17%; height: 4%; }
  .ps__btn--up { left: calc(var(--h) * -0.005); top: 24%; height: 7%; }
  .ps__btn--down { left: calc(var(--h) * -0.005); top: 33%; height: 7%; }
  .ps__btn--power { right: calc(var(--h) * -0.005); top: 26%; height: 10%; }

  /* Progress — bottom right of the stage, on the grid margin */
  .ps__progress {
    position: absolute;
    right: var(--margin);
    bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-3);
  }

  .ps__bar {
    position: relative;
    width: 96px;
    height: 1.5px;
    background: var(--rule);
  }

  .ps__bar i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--signal);
  }

  @media (max-width: 640px) {
    .ps__device {
      --h: min(68svh, 600px);
    }

    .ps__progress {
      left: var(--margin);
      right: auto;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-ps]').forEach((el) => {
    const shots = Array.from(el.querySelectorAll<HTMLElement>('[data-shot]'));
    const count = el.querySelector<HTMLElement>('[data-ps-count]')!;
    const bar = el.querySelector<HTMLElement>('[data-ps-bar]')!;
    const n = shots.length;
    const total = String(n).padStart(2, '0');
    let target = 0;
    let cur = 0;
    let raf = 0;
    let shown = -1;

    // Snap only while the scene is on screen (proximity, so the rest of the page scrolls freely).
    const root = document.documentElement;
    new IntersectionObserver(([e]) => {
      root.style.scrollSnapType = e.isIntersecting ? 'y proximity' : '';
    }, { threshold: 0.6 }).observe(el.querySelector('.ps__stage')!);

    const measure = () => {
      const r = el.getBoundingClientRect();
      const step = window.innerHeight * 0.5;
      target = Math.min(n - 1, Math.max(0, -r.top / step));
    };

    const render = () => {
      // Dissolve: everything up to the current screen stays fully opaque underneath; the next
      // screen fades in on top while settling from a slight zoom. No dip to black mid-way.
      const base = Math.floor(cur);
      const t = cur - base;
      shots.forEach((s, i) => {
        let o = 0;
        let sc = 1;
        if (i <= base) {
          o = 1;
          sc = 1;
        } else if (i === base + 1) {
          o = t;
          sc = 1 + (1 - t) * 0.06;
        }
        s.style.opacity = o.toFixed(4);
        s.style.transform = `scale(${sc.toFixed(4)})`;
        s.style.zIndex = String(i);
      });
      const k = Math.round(cur);
      if (k !== shown) {
        count.textContent = `${String(k + 1).padStart(2, '0')} / ${total}`;
        shown = k;
      }
      bar.style.width = `${n > 1 ? (cur / (n - 1)) * 100 : 100}%`;
    };

    const loop = () => {
      cur += (target - cur) * (reduced ? 1 : 0.14);
      if (Math.abs(target - cur) < 0.0005) cur = target;
      render();
      raf = cur !== target ? requestAnimationFrame(loop) : 0;
    };

    const onScroll = () => {
      measure();
      if (!raf) raf = requestAnimationFrame(loop);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();
  });
</script>

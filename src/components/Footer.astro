---
import { site } from '../data/site';

interface Props {
  // The About page has its own Contact section, so it hides the footer's.
  showContact?: boolean;
}

const { showContact = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="wrap footer">
  {
    showContact && (
      <div class="sec footer__contact" data-reveal="sec">
        <div class="sec__head">
          <p class="label">Contact</p>
        </div>
        <ul class="sec__body trio footer__links">
          <li>
            <span class="label muted">Email</span>
            <a class="link" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </li>
          <li>
            <span class="label muted">LinkedIn</span>
            <a href={site.linkedin} target="_blank" rel="noopener">
              Valerio Rosponi <span class="arrow arrow--ne" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <span class="label muted">Résumé</span>
            <a href={site.cv} target="_blank" rel="noopener">
              Download PDF <span class="arrow arrow--ne" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    )
  }

  <p class="footer__mega" aria-hidden="true">Valerio Rosponi</p>

  <div class="footer__base label">
    <span class="muted">© {year} {site.name}</span>
    <a href="#top" class="footer__top">Back to top <span class="arrow footer__up" aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-section);
    padding-bottom: var(--space-3);
  }

  .footer__contact {
    margin-top: 0;
  }

  .footer__links li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 0.9375rem;
  }

  .footer__links a {
    align-self: flex-start;
  }

  .footer__mega {
    margin-top: var(--space-section);
    font-size: clamp(3rem, 14.2vw, 15.25rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.065em;
    white-space: nowrap;
    user-select: none;
    margin-left: -0.05em;
  }

  .footer__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
  }

  a:hover .footer__up {
    transform: translateY(-3px);
  }

  @media (max-width: 640px) {
    .footer__mega {
      white-space: normal;
      font-size: 23vw;
      line-height: 0.84;
    }
  }
</style>

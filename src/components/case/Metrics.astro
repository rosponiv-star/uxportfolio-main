---
// Key numbers on the three body-lane tracks: each stands on a hairline, large and bare, with a short label
// below. Digits count up once when they come into view (see Stat.astro).
// items: [{ value: '41', label: 'Survey responses' }, { value: '−40%', label: '…' }]
import Stat from './Stat.astro';

interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<dl class="metrics trio">
  {
    items.map((m, i) => (
      <div class="metric" data-reveal style={`--d: ${i}`}>
        <dt class="metric__label label muted">{m.label}</dt>
        <dd class="metric__value">
          <Stat value={m.value} />
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-strong);
  }

  .metric__value {
    margin: 0;
  }

  .metric__label {
    max-width: 24ch;
  }
</style>

---
// Key numbers on the three body-lane tracks: each stands on a hairline, large and bare, with a short label
// and, optionally, one line of context below. Digits count up once when they come into view (Stat.astro).
// items: [{ value: '41', label: 'Survey responses', text?: 'Shared in WhatsApp groups…' }]
// title: a group heading above the row. variant 'boxed': each number in a tinted box (to tell a second kind
// of number, e.g. what came out of the research, apart from the first).
import Stat from './Stat.astro';

interface Props {
  items: { value: string; label: string; text?: string }[];
  title?: string;
  variant?: 'plain' | 'boxed';
}
const { items, title, variant = 'plain' } = Astro.props;
---

{title && <p class="metrics__title label label--group">{title}</p>}
<dl class:list={['metrics trio', `metrics--${variant}`]}>
  {
    items.map((m, i) => (
      <div class="metric" data-reveal style={`--d: ${i}`}>
        <dt class="metric__label field">{m.label}</dt>
        <dd class="metric__value">
          <Stat value={m.value} />
        </dd>
        {m.text && <dd class="metric__text">{m.text}</dd>}
      </div>
    ))
  }
</dl>

<style>
  /* A group heading opens a new block: full block spacing above, close to its numbers below. */
  .metrics__title {
    margin-top: var(--space-block);
  }

  .metrics__title + .metrics {
    margin-top: var(--space-3);
  }

  .metrics--boxed .metric {
    padding: var(--space-3);
    border-top: 0;
    background: var(--paper-2);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--ink);
  }

  .metric__value,
  .metric__text {
    margin: 0;
  }

  .metric__value {
    order: -1;
    margin-bottom: var(--space-1);
  }

  /* Caption of the number: a field, not a heading (group headings stay in uppercase labels). */
  .metric__label {
    max-width: 26ch;
    font-weight: 500;
    color: var(--ink);
  }

  .metric__text {
    max-width: 34ch;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
  }

  /* In a chapter the numbers are cells: equal widths across the body lane, number on top, its label and
     context pinned to the bottom (the Result keeps the bare numbers on ink rules above). */
  :global(.prose) > .metrics {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    column-gap: 0;
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }

  :global(.prose) > .metrics .metric {
    gap: 4px;
    padding: var(--space-3);
    border-top: 0;
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    background: none;
  }

  :global(.prose) > .metrics .metric__value {
    margin-bottom: auto;
    padding-bottom: var(--space-5);
  }

  :global(.prose) > .metrics--boxed .metric {
    background: var(--paper-2);
  }

  @media (max-width: 640px) {
    :global(.prose) > .metrics {
      grid-auto-flow: row;
      grid-auto-columns: auto;
    }

  }
</style>

---
// Row of key numbers. items: [{ value: '8', label: 'User interviews' }, ...]
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<dl class="metrics" style={`--n: ${items.length}`}>
  {
    items.map((m, i) => (
      <div class="metric" data-reveal style={`--d: ${i}`}>
        <dt class="label muted">{m.label}</dt>
        <dd class="metric__value">{m.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: var(--gutter);
    margin-block: 2.5em;
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    border-top: 1px solid var(--ink);
    padding-top: 10px;
  }

  .metric__value {
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }
  }
</style>

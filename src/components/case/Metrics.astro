---
// Key numbers on the three body-lane tracks. items: [{ value: '8', label: 'User interviews' }, ...]
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<dl class="metrics trio">
  {
    items.map((m, i) => (
      <div class="metric" data-reveal style={`--d: ${i}`}>
        <dt class="label muted">{m.label}</dt>
        <dd class="metric__value">{m.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .metric__value {
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--ink);
  }
</style>

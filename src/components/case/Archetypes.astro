---
// Behavioural archetypes side by side, as a comparison: row labels in track A, one light box per archetype
// in tracks B and C, so every row (quote, friction, opportunity…) reads across. Trait labels come from the
// first archetype; give both the same labels in the same order. On phones each archetype is its own box.
interface Props {
  items: {
    name: string;
    alias?: string;
    quote: string;
    traits: { label: string; text: string }[];
  }[];
}
const { items } = Astro.props;
const rows = ['In their words', ...items[0].traits.map((t) => t.label)];
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="arch" style={`--rows: ${rows.length + 1}`} data-reveal>
  {items.slice(0, 2).map((_, c) => <span class="arch__box" style={`grid-column: ${c + 2}`} aria-hidden="true" />)}

  {rows.map((r, ri) => <p class="arch__rowlabel label muted" style={`grid-row: ${ri + 2}`}>{r}</p>)}

  {
    items.slice(0, 2).map((a, c) => (
      <>
        <div class="arch__cell arch__head" style={`grid-column: ${c + 2}; grid-row: 1; --o: ${c * 10}`}>
          <span class="label arch__alias">
            {n(c)}
            {a.alias && ` — ${a.alias}`}
          </span>
          <h3 class="arch__name">{a.name}</h3>
        </div>
        <blockquote class="arch__cell arch__quote" style={`grid-column: ${c + 2}; grid-row: 2; --o: ${c * 10 + 1}`}>
          <span class="arch__mlabel label muted">{rows[0]}</span>“{a.quote}”
        </blockquote>
        {a.traits.map((t, ti) => (
          <div
            class:list={['arch__cell arch__trait', { 'is-last': ti === a.traits.length - 1 }]}
            style={`grid-column: ${c + 2}; grid-row: ${ti + 3}; --o: ${c * 10 + ti + 2}`}
          >
            <span class="arch__mlabel label muted">{t.label}</span>
            {t.text}
          </div>
        ))}
      </>
    ))
  }
</div>

<style>
  .arch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    column-gap: var(--gutter);
  }

  /* One light box per archetype, behind its column. */
  .arch__box {
    grid-row: 1 / -1;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
  }

  .arch__cell {
    position: relative;
    padding: var(--space-3);
  }

  .arch__quote,
  .arch__trait {
    border-top: 1px solid var(--rule);
  }

  .arch__rowlabel {
    padding-top: var(--space-3);
    text-box: trim-start cap alphabetic;
  }

  .arch__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-3);
  }

  .arch__alias {
    color: var(--signal);
  }

  .arch__name {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.022em;
    color: var(--ink);
  }

  /* The quote is the voice of the archetype: the largest text in the box. */
  .arch__quote {
    margin: 0;
    border-left: 0;
    padding-left: var(--space-3);
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: none;
  }

  .arch__trait {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .arch__mlabel {
    display: none;
  }

  /* Phones: one box per archetype, labels inside. */
  @media (max-width: 640px) {
    .arch {
      display: flex;
      flex-direction: column;
    }

    .arch__box,
    .arch__rowlabel {
      display: none;
    }

    .arch__cell {
      order: var(--o);
      border-inline: 1px solid var(--rule-strong);
    }

    .arch__head {
      border-top: 1px solid var(--rule-strong);
    }

    .arch__head:not(:first-of-type) {
      margin-top: var(--space-4);
    }

    .arch__trait.is-last {
      border-bottom: 1px solid var(--rule-strong);
    }

    .arch__mlabel {
      display: block;
      margin-bottom: var(--space-1);
    }
  }
</style>

---
// Behavioural archetypes side by side, as a light comparison: row labels in track A, one column per archetype
// in tracks B and C (an ink rule on top, hairlines between rows, no boxes), so every row (quote, friction, opportunity…) reads across. Trait labels come from the
// first archetype; give both the same labels in the same order. `goal` (2–3 words) opens each box in large type:
// it is what the two disagree on, so it is the first thing to compare. On phones each archetype is its own box.
interface Props {
  items: {
    name: string;
    alias?: string;
    goal?: string;
    quote: string;
    traits: { label: string; text: string }[];
  }[];
}
const { items } = Astro.props;
const hasGoal = items.every((a) => a.goal);
const rows = [...(hasGoal ? ['Wants'] : []), 'In their words', ...items[0].traits.map((t) => t.label)];
const off = hasGoal ? 1 : 0;
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="arch" style={`--rows: ${rows.length + 1}`} data-reveal>
  {items.slice(0, 2).map((_, c) => <span class="arch__box" style={`grid-column: ${c + 2}`} aria-hidden="true" />)}

  {rows.map((r, ri) => <p class="arch__rowlabel label label--group" style={`grid-row: ${ri + 2}`}>{r}</p>)}

  {
    items.slice(0, 2).map((a, c) => (
      <>
        <div class="arch__cell arch__head" style={`grid-column: ${c + 2}; grid-row: 1; --o: ${c * 10}`}>
          <span class="label arch__alias">
            {n(c)}
            {a.alias && ` — ${a.alias}`}
          </span>
          <h3 class="arch__name">{a.name}</h3>
        </div>
        {hasGoal && (
          <p class="arch__cell arch__goal" style={`grid-column: ${c + 2}; grid-row: 2; --o: ${c * 10 + 1}`}>
            <span class="arch__mlabel field">Wants</span>
            {a.goal}
          </p>
        )}
        <blockquote class="arch__cell arch__quote" style={`grid-column: ${c + 2}; grid-row: ${2 + off}; --o: ${c * 10 + 2}`}>
          <span class="arch__mlabel field">In their words</span>“{a.quote}”
        </blockquote>
        {a.traits.map((t, ti) => (
          <div
            class:list={['arch__cell arch__trait', { 'is-last': ti === a.traits.length - 1 }]}
            style={`grid-column: ${c + 2}; grid-row: ${ti + 3 + off}; --o: ${c * 10 + ti + 3}`}
          >
            <span class="arch__mlabel field">{t.label}</span>
            {t.text}
          </div>
        ))}
      </>
    ))
  }
</div>

<style>
  .arch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    column-gap: 0;
  }

  /* Light comparison: no boxes, no tint, no column rules. One continuous light hairline per row runs
     across all three tracks (no column gap; the gutter is padding), so every row reads left to right. */
  .arch__box {
    display: none;
  }

  .arch__cell,
  .arch__rowlabel {
    position: relative;
    padding-block: var(--space-3);
    padding-right: var(--gutter);
  }

  .arch__goal,
  .arch__quote,
  .arch__trait,
  .arch__rowlabel {
    border-top: 1px solid var(--rule);
  }

  .arch__rowlabel {
    align-self: stretch;
    padding-top: var(--space-3);
    color: var(--ink-3);
  }

  .arch__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: 0 var(--space-4);
  }

  /* What they want: the largest text in the box, the first thing to compare. */
  .arch__goal {
    margin: 0;
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .arch__alias {
    color: var(--signal);
  }

  .arch__name {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.022em;
    color: var(--ink);
  }

  /* The quote is the voice of the archetype. */
  .arch__quote {
    margin: 0;
    border-left: 0;
    padding-left: 0;
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: none;
  }

  .arch__trait {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .arch__mlabel {
    display: none;
  }

  /* Phones: one archetype after the other, labels inside. */
  @media (max-width: 640px) {
    .arch {
      display: flex;
      flex-direction: column;
    }

    .arch__box,
    .arch__rowlabel {
      display: none;
    }

    .arch__cell {
      order: var(--o);
    }

    .arch__head:not(:first-of-type) {
      margin-top: var(--space-4);
    }

    .arch__mlabel {
      display: block;
      margin-bottom: var(--space-1);
    }
  }
</style>

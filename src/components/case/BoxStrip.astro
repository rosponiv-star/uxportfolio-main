---
// Product line as colour blocks: one solid panel per product in its own colour, the product (a cut-out,
// ideally in perspective) large inside it, name and role in white at the foot. Spans tracks A–C.
// Under the pointer the product turns: `hover` (e.g. the front view) cross-fades over `image` (the perspective).
// On phones the panels become a 2×2 grid.
//   <BoxStrip items={[{ name: 'Box A', role: 'Protein', color: '#ffa91e', image: boxA3, alt: '…' }]} />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { name: string; role: string; color: string; image: ImageMetadata; hover?: ImageMetadata; alt: string }[];
}
const { items } = Astro.props;
---

<ul class="strip" style={`--count: ${items.length}`} data-reveal>
  {
    items.map((it) => (
      <li class="panel" style={`--c: ${it.color}`}>
        <div class="panel__media">
          <Image src={it.image} alt={it.alt} widths={[320, 480, 720]} sizes="(min-width: 960px) 18vw, 45vw" />
          {it.hover && (
            <Image class="panel__hover" src={it.hover} alt="" widths={[320, 480, 720]} sizes="(min-width: 960px) 18vw, 45vw" />
          )}
        </div>
        <p class="panel__cap">
          <span class="panel__name">{it.name}</span>
          <span class="panel__role">{it.role}</span>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    gap: 0;
  }

  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    min-height: 0;
    padding: var(--space-3);
    background: var(--c);
    overflow: hidden;
  }

  .panel__media {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .panel__media :global(img) {
    display: block;
    width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.9s var(--ease-out);
  }

  .panel__media :global(.panel__hover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .panel:hover .panel__media :global(img:not(.panel__hover)) {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .panel:hover .panel__media :global(.panel__hover) {
    opacity: 1;
  }

  .panel__cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: #fff;
  }

  .panel__name {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .panel__role {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
// Annotated block: the wrapped content sits in tracks A–B, the designer's note
// in track C, top-aligned with it. On small screens the note follows the content.
//   <Note label="Decision" text="Why I did it this way.">Paragraph…</Note>
interface Props {
  label?: string;
  text: string;
}
const { label = 'Decision', text } = Astro.props;
---

<div class="note-row trio">
  <div class="note-row__main span-2"><slot /></div>
  <aside class="note" data-reveal style="--d: 1">
    <p class="note__label label"><span class="reg"></span>{label}</p>
    <p class="note__text">{text}</p>
  </aside>
</div>

<style>
  .note-row {
    row-gap: var(--space-3);
  }

  .note-row__main > :global(* + *) {
    margin-top: 1em;
  }

  .note-row__main > :global(:first-child) {
    text-box: trim-start cap alphabetic;
  }

  .note {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .note__label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-1);
    color: var(--signal);
    text-box: trim-start cap alphabetic;
  }

  @media (max-width: 640px) {
    .note {
      padding-left: var(--space-2);
      border-left: 1px solid var(--signal);
    }
  }
</style>

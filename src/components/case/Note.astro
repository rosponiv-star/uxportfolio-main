---
// A designer's note, read in sequence: the content it annotates first, then the note right below it as a
// tinted callout on the same A–B measure (no side column to look for). Without content, just the callout.
//   <Note label="Decision" text="Why I did it this way.">Paragraph…</Note>
interface Props {
  label?: string;
  text: string;
}
const { label = 'Decision', text } = Astro.props;
const hasContent = Astro.slots.has('default');
---

<div class="note-row">
  {hasContent && <div class="note-row__main"><slot /></div>}
  <aside class="note" data-reveal style="--d: 1">
    <p class="note__label label"><span class="reg"></span>{label}</p>
    <p class="note__text">{text}</p>
  </aside>
</div>

<style>
  .note-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: calc((200% - var(--gutter)) / 3);
  }

  .note-row__main > :global(* + *) {
    margin-top: 1em;
  }

  .note-row__main > :global(:first-child) {
    text-box: trim-start cap alphabetic;
  }

  .note {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    background: var(--paper-2);
  }

  .note__label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--signal);
    text-box: trim-start cap alphabetic;
  }

  .note__text {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .note-row {
      max-width: none;
    }
  }
</style>

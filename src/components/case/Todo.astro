---
// Visible placeholder describing the content that will fill this spot.
// Spans the full body lane. Remove once the real copy is in.
interface Props {
  label?: string;
}
const { label = 'To populate' } = Astro.props;
---

<div class="todo">
  <p class="todo__label label"><span class="dot"></span>{label}</p>
  <div class="todo__body"><slot /></div>
</div>

<style>
  .todo {
    padding: var(--space-3);
    border: 1px dashed var(--ink-4);
    color: var(--ink-3);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .todo__label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-1);
    color: var(--ink);
  }

  .todo__body {
    max-width: 72ch;
  }

  .todo__body :global(p + p) {
    margin-top: 0.6em;
  }
</style>

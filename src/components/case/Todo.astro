---
// Visible placeholder describing the content that will fill this spot.
// Remove once the real copy is in.
interface Props {
  label?: string;
}
const { label = 'To populate' } = Astro.props;
---

<div class="todo">
  <p class="todo__label label"><span class="dot"></span>{label}</p>
  <div class="todo__body"><slot /></div>
</div>

<style>
  .todo {
    margin-block: 1.5em;
    padding: 16px 18px 18px;
    border: 1px dashed var(--ink-4);
    color: var(--ink-3);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .todo__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--ink);
  }

  .todo__body :global(p + p) {
    margin-top: 0.6em;
  }
</style>

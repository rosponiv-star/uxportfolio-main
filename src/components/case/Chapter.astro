---
// A case-study chapter, built on the site-wide Section pattern: numbered title in
// the head lane (sticky), content in the body lane. Titles also feed the page's
// Contents list (see lib/projects.ts → chaptersOf).
import Section from '../Section.astro';
import { chapterId } from '../../lib/projects';

interface Props {
  title: string;
  tone?: 'alt';
}
const { title, tone } = Astro.props;
---

<Section title={title} id={chapterId(title)} class="chapter" bodyClass="prose flow" tone={tone}>
  <span slot="pre" class="label chapter__n" aria-hidden="true"></span>
  <slot />
</Section>

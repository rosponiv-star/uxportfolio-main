---
// A case-study chapter: heading in the left column (sticky on wide screens),
// content on the right. Chapters are numbered automatically, and listed in the
// page's Contents from their titles (see lib/projects.ts → chaptersOf).
import { chapterId } from '../../lib/projects';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="chapter" aria-labelledby={chapterId(title)}>
  <div class="chapter__head">
    <h2 id={chapterId(title)}>{title}</h2>
  </div>
  <div class="chapter__body">
    <slot />
  </div>
</section>

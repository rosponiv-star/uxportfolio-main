---
// Product features with the screen that delivers each one. Each row: the device, cropped to its top part and
// standing on a hairline, in track A; number, title and text in tracks B–C. Rows are separated by hairlines.
// items: [{ title, text, image, alt, crop?, anchor? }]; crop = share of the device height shown (default 0.55);
// an item can override it (a widget needs only the top third) and take anchor 'bottom' to show the bottom share
// instead (a lock-screen notification), with the cut at the top.
// alternate: the device switches side row by row (track A, then track C), for rhythm.
// Without `image` the row shows a placeholder frame (`placeholder` says what belongs there; `device`
// sets its shape: a phone, cropped like the real shots, or a 16:9 TV) until the real screen arrives.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Figure from './Figure.astro';

interface Props {
  items: {
    title: string;
    text: string;
    image?: ImageMetadata;
    alt: string;
    placeholder?: string;
    device?: 'phone' | 'tv';
    crop?: number;
    anchor?: 'top' | 'bottom';
    // A second screen right after the first (a two-step moment): both devices sit side by side on two
    // tracks, the text takes the third. `note` adds a tinted callout under the text.
    also?: ImageMetadata;
    alsoAlt?: string;
    note?: { label: string; text: string };
  }[];
  crop?: number;
  alternate?: boolean;
}
const { items, crop = 0.55, alternate = false } = Astro.props;
// Placeholder shapes: an iPhone screen (9:19.5) cut at the same crop as the real shots, or a TV.
const phRatio = (device?: 'phone' | 'tv') => (device === 'tv' ? '16/9' : `9/${Math.round(19.5 * crop)}`);
---

<ol class:list={['features', { 'features--alt': alternate }]}>
  {
    items.map((it, i) => (
      <li class:list={['feature trio', { 'feature--pair': it.also }]} data-reveal style={`--d: ${i}`}>
        {it.image && it.also ? (
          <div class="feature__pair span-2">
            {[
              { img: it.image, alt: it.alt },
              { img: it.also, alt: it.alsoAlt ?? '' },
            ].map((s) => (
              <div class="feature__shot" style={`aspect-ratio: ${s.img.width} / ${Math.round(s.img.height * (it.crop ?? crop))}`}>
                <Image src={s.img} alt={s.alt} widths={[320, 480, 640]} sizes="(min-width: 960px) 22vw, 45vw" />
              </div>
            ))}
          </div>
        ) : it.image ? (
          <div class:list={['feature__shot', { 'feature__shot--bottom': it.anchor === 'bottom' }]} style={`aspect-ratio: ${it.image.width} / ${Math.round(it.image.height * (it.device === 'tv' ? 1 : (it.crop ?? crop)))}`}>
            <Image src={it.image} alt={it.alt} widths={[320, 480, 640]} sizes="(min-width: 960px) 22vw, 60vw" />
          </div>
        ) : (
          <div class="feature__shot feature__shot--ph">
            <Figure ratio={phRatio(it.device)} placeholder={it.placeholder ?? 'Screen'} size="wide" />
          </div>
        )}
        <div class:list={['feature__body', { 'span-2': !it.also }]}>
          <span class="feature__n label">{String(i + 1).padStart(2, '0')}</span>
          <p class="feature__title">{it.title}</p>
          <p class="feature__text">{it.text}</p>
          {it.note && (
            <aside class="feature__note">
              <p class="label">{it.note.label}</p>
              <p>{it.note.text}</p>
            </aside>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* The device stands on the hairline that closes its row; the text sits centred on the screen. */
  .feature {
    align-items: end;
    padding-block: var(--space-5) 0;
  }

  .feature + .feature {
    border-top: 1px solid var(--rule);
  }

  .feature:first-child {
    padding-top: 0;
  }

  .feature__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
  }

  .feature__note {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding: var(--space-3);
    background: var(--paper-2);
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink);
  }

  .feature__note .label {
    color: var(--signal);
  }

  /* The device stands on the row's bottom edge: cropped, it reads like a phone rising from the line. */
  .feature__shot {
    position: relative;
    overflow: hidden;
    max-width: 80%;
  }

  .feature__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Bottom share: the image sits on the bottom edge and overflows upwards. */
  .feature__shot--bottom {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .feature__shot--bottom :global(img) {
    flex-shrink: 0;
  }

  /* Placeholder frames have their own ratio; let them size the cell. */
  .feature__shot--ph {
    overflow: visible;
  }

  .feature__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-self: center;
    padding-block: var(--space-4);
  }

  .feature__n {
    color: var(--signal);
  }

  .feature__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.022em;
    color: var(--ink);
  }

  .feature__text {
    max-width: 52ch;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* Alternating rows: every second device moves to track C, its text to tracks A–B. */
  .features--alt .feature__shot {
    max-width: none;
  }

  .features--alt .feature:nth-child(even) :is(.feature__shot, .feature__pair) {
    order: 2;
  }

  .feature__pair .feature__shot {
    max-width: none;
  }

  @media (max-width: 640px) {
    .features--alt .feature:nth-child(even) .feature__shot {
      order: 0;
    }

    .features--alt .feature__shot {
      max-width: 70%;
    }

    .feature__shot {
      max-width: 62%;
    }

    .feature__body {
      padding-block: var(--space-2) var(--space-4);
    }
  }
</style>

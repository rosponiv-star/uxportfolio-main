---
// Problem-reframing cycles (Client–Problem–Solution iterations) as one row of cells, read left to right:
// each cycle's number, who it was for, the problem and the idea. Ideas from earlier cycles were discarded,
// so they are struck through; the last cell, the final framing, is inked in.
// `n` is the real cycle number. `cycles` (the total) is accepted for older MDX but no longer drawn:
// the chapter's key sentence already says how many there were.
interface Props {
  items: { client: string; problem: string; idea?: string; n?: number }[];
  cycles?: number;
}
const { items } = Astro.props;
const last = items.length - 1;
const pad = (v: number) => String(v).padStart(2, '0');
---

<ol class="reframes cells">
  {
    items.map((it, i) => (
      <li
        class:list={['cell step', { 'step--final': i === last }]}
        data-reveal
        style={`--d: ${i}; grid-column: span ${6 / Math.min(items.length, 3)}`}
      >
        <span class="step__n label">
          {i === last ? `Cycle ${pad(it.n ?? i + 1)} · Final framing` : `Cycle ${pad(it.n ?? i + 1)}`}
        </span>
        <p class="step__client">{it.client}</p>
        <dl class="step__rows">
          <div>
            <dt class="field">Problem</dt>
            <dd>{it.problem}</dd>
          </div>
          {it.idea && (
            <div class:list={{ 'is-discarded': i !== last }}>
              <dt class="field">{i === last ? 'Idea' : 'Idea, discarded'}</dt>
              <dd>{i === last ? it.idea : <s>{it.idea}</s>}</dd>
            </div>
          )}
        </dl>
      </li>
    ))
  }
</ol>

<style>
  /* Subgrid: number, client and fields line up across the cells, whatever each one's length. */
  .step {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: var(--space-2);
    align-content: start;
  }

  .step__n {
    color: var(--signal);
  }

  .step__client {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.022em;
    color: var(--ink);
  }

  .step__rows {
    display: grid;
    gap: var(--space-2);
    margin-bottom: 0;
    padding-top: var(--space-4);
    font-size: var(--fs-body);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .step__rows > div {
    display: grid;
    gap: 2px;
  }

  .step__rows dd {
    margin: 0;
  }

  .is-discarded dd {
    color: var(--ink-4);
  }

  .is-discarded s {
    text-decoration-thickness: 1px;
    text-decoration-color: var(--ink-3);
  }

  /* The final framing: the one cell that is inked in. */
  .step--final {
    background: var(--ink);
    color: var(--paper);
  }

  .step--final .step__n,
  .step--final .step__rows dt {
    color: color-mix(in srgb, var(--paper) 60%, transparent);
  }

  .step--final .step__client,
  .step--final .step__rows {
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .step {
      grid-row: auto;
      grid-template-rows: none;
    }
  }
</style>

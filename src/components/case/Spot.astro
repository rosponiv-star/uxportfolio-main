---
// A key screen shown in someone's hand: the photo on tracks B–C, the words that frame it on track A,
// sitting on the photo's baseline so the eye reads text first, then the moment.
// <Spot image={img} alt="…" label="19:45">short text</Spot>   label = an optional field above the text.
// zoom="52% 47%" = while the photo crosses the viewport it eases in (to 1.4) on that point, the screen.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  label?: string;
  zoom?: string;
}
const { image, alt, label, zoom } = Astro.props;
---

<figure class="spot trio" data-reveal>
  <figcaption class="spot__text">
    {label && <span class="spot__label label label--group">{label}</span>}
    <slot />
  </figcaption>
  <div class:list={["spot__img span-2", { "spot__img--zoom": zoom }]} style={zoom ? `--zoom-at: ${zoom}` : undefined}>
    <Image src={image} alt={alt} widths={[640, 960, 1400, 1800]} sizes="(min-width: 960px) 50vw, 100vw" />
  </div>
</figure>

<style>
  .spot {
    align-items: end;
    margin: 0;
  }

  .spot__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }

  .spot__text :global(p) {
    margin: 0;
  }

  .spot__img :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Scroll-linked zoom on the screen: compositor-driven, no JS; static where unsupported or reduced motion. */
  .spot__img--zoom {
    overflow: clip;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .spot__img--zoom :global(img) {
        transform-origin: var(--zoom-at);
        animation: spot-zoom linear both;
        animation-timeline: view();
        animation-range: cover 20% cover 60%;
      }
    }
  }

  @keyframes spot-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.4); }
  }

  @media (max-width: 640px) {
    .spot__text {
      order: 2;
      border-bottom: 0;
      padding-bottom: 0;
    }
  }
</style>

---
// Numbered key insights: number + finding in track A, evidence in tracks B–C.
// items: [{ title: '...', text: '...' }, ...]
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---

<ol class="insights">
  {
    items.map((it, i) => (
      <li class="insight trio" data-reveal style={`--d: ${i}`}>
        <div class="insight__head">
          <span class="insight__n label">{String(i + 1).padStart(2, '0')}</span>
          <p class="insight__title">{it.title}</p>
        </div>
        <p class="insight__text span-2">{it.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .insight {
    row-gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .insight:first-child {
    padding-top: 0;
  }

  .insight + .insight {
    border-top: 1px solid var(--rule);
  }

  .insight__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .insight__n {
    color: var(--signal);
  }

  .insight__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.15;
    color: var(--ink);
  }

  .insight__text {
    color: var(--ink-3);
    max-width: 58ch;
  }
</style>

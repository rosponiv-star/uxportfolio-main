---
// Numbered key insights as cells across the body lane: number and finding on top, the evidence below it,
// and the number that backs it (`stat` + short `statLabel`) pinned to the bottom of the cell.
// 4 items = 2 × 2, 3 = thirds, 5 = three thirds then two halves.
// variant 'compact': a lighter list (title in lead size) for plans and short points.
// items: [{ title: '...', text: '...', stat?: '95%', statLabel?: '…' }, ...]
import Stat from './Stat.astro';

interface Props {
  items: { title: string; text: string; stat?: string; statLabel?: string }[];
  variant?: 'default' | 'compact';
}
const { items, variant = 'default' } = Astro.props;
const n = items.length;
// Width of each cell in the 6-unit cell grid.
const spanOf = (i: number) => (n % 3 === 0 ? 2 : n % 2 === 0 ? 3 : i < n - 2 ? 2 : 3);
const compact = variant === 'compact';
---

<ol class:list={['insights', `insights--${variant}`, { cells: !compact }]}>
  {
    items.map((it, i) => (
      <li class:list={['insight', { cell: !compact }]} data-reveal style={`--d: ${i}${compact ? '' : `; grid-column: span ${spanOf(i)}`}`}>
        <p class="insight__head">
          <span class="insight__n label">{String(i + 1).padStart(2, '0')}</span>
          <span class="insight__title">{it.title}</span>
        </p>
        <p class="insight__text">{it.text}</p>
        {it.stat && (
          <p class="insight__stat cell__foot">
            <Stat value={it.stat} />
            {it.statLabel && <span class="insight__statlabel">{it.statLabel}</span>}
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .insights--default .insight {
    gap: var(--space-3);
    min-height: 320px;
  }

  .insight__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .insight__n {
    color: var(--signal);
  }

  .insight__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.15;
    color: var(--ink);
  }

  .insight__text {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .insight__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-4);
  }

  .insight__statlabel {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-3);
  }

  /* Compact: a light list, number and title on one baseline, the text right under it. */
  .insights--compact {
    max-width: calc((200% - var(--gutter)) / 3);
  }

  .insights--compact .insight {
    display: grid;
    grid-template-columns: var(--space-5) minmax(0, 1fr);
    align-items: baseline;
    row-gap: var(--space-1);
    padding-block: var(--space-3);
  }

  .insights--compact .insight + .insight {
    border-top: 1px solid var(--rule);
  }

  .insights--compact .insight:first-child {
    padding-top: 0;
  }

  .insights--compact .insight__head {
    display: contents;
  }

  .insights--compact .insight__title {
    font-size: var(--fs-lead);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .insights--compact .insight__text,
  .insights--compact .insight__stat {
    grid-column: 2;
  }

  @media (max-width: 640px) {
    .insights--default .insight {
      min-height: 0;
    }

    .insights--compact {
      max-width: none;
    }
  }
</style>

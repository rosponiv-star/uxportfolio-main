---
// Numbered key insights: number + finding in track A, evidence in tracks B–C.
// An insight backed by a number shows it first, large (`stat`, with an optional short `statLabel`).
// items: [{ title: '...', text: '...', stat?: '95%', statLabel?: '…' }, ...]
import Stat from './Stat.astro';

interface Props {
  items: { title: string; text: string; stat?: string; statLabel?: string }[];
}
const { items } = Astro.props;
---

<ol class="insights">
  {
    items.map((it, i) => (
      <li class="insight trio" data-reveal style={`--d: ${i}`}>
        <div class="insight__head">
          <span class="insight__n label">{String(i + 1).padStart(2, '0')}</span>
          <p class="insight__title">{it.title}</p>
        </div>
        <div class="insight__body span-2">
          {it.stat && (
            <p class="insight__stat">
              <Stat value={it.stat} />
              {it.statLabel && <span class="label muted">{it.statLabel}</span>}
            </p>
          )}
          <p class="insight__text">{it.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .insight {
    row-gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .insight:first-child {
    padding-top: 0;
  }

  .insight + .insight {
    border-top: 1px solid var(--rule);
  }

  .insight__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .insight__n {
    color: var(--signal);
  }

  .insight__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.15;
    color: var(--ink);
  }

  .insight__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .insight__stat {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: var(--space-2);
    row-gap: var(--space-1);
  }

  .insight__text {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 58ch;
  }
</style>

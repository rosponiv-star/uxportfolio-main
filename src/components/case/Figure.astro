---
// Case-study figure. Pass `src` (imported image) or `video`; without either it
// renders a sized placeholder frame that says what belongs there.
// size: 'wide' (default, full body lane: tracks A–C) | 'text' (tracks A–B)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  video?: string;
  alt?: string;
  caption?: string;
  ratio?: string;
  size?: 'wide' | 'text';
  placeholder?: string;
  bg?: string;
}

const {
  src,
  video,
  alt = '',
  caption,
  ratio = '16/9',
  size = 'wide',
  placeholder = 'Image',
  bg,
} = Astro.props;
---

<figure class:list={['fig', `fig--${size}`]} data-reveal>
  <div class="fig__frame" style={`aspect-ratio: ${ratio};${bg ? ` background:${bg};` : ''}`}>
    {
      video ? (
        <video src={video} muted loop playsinline preload="metadata" data-autoplay aria-label={alt} />
      ) : src ? (
        <Image src={src} alt={alt} widths={[640, 1024, 1600, 2400]} sizes="(min-width: 960px) 72vw, 100vw" />
      ) : (
        <div class="fig__ph">
          <span class="reg fig__reg fig__reg--tl" />
          <span class="reg fig__reg fig__reg--br" />
          <span class="label">{placeholder}</span>
          <span class="label muted">{ratio.replace('/', ':')}</span>
        </div>
      )
    }
  </div>
  {caption && <figcaption class="fig__cap">{caption}</figcaption>}
</figure>

<style>
  .fig--text {
    max-width: calc((200% - var(--gutter)) / 3);
  }

  .fig__frame {
    position: relative;
    overflow: hidden;
    background: var(--paper-2);
  }

  .fig__frame :global(img),
  .fig__frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fig__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    text-align: center;
    padding: var(--space-3);
    background-image:
      linear-gradient(to right, var(--paper-3) 1px, transparent 1px),
      linear-gradient(to bottom, var(--paper-3) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center;
  }

  .fig__reg {
    position: absolute;
    color: var(--ink-4);
  }

  .fig__reg--tl {
    top: var(--space-2);
    left: var(--space-2);
  }

  .fig__reg--br {
    bottom: var(--space-2);
    right: var(--space-2);
  }

  .fig__cap {
    margin-top: var(--space-2);
    max-width: calc((200% - var(--gutter)) / 3);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .fig--text,
    .fig__cap {
      max-width: none;
    }
  }
</style>

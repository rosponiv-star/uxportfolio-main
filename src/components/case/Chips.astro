---
// A short list pulled out of a sentence, laid out as an item row: the group label and one line of context
// in track A, the chips in tracks B–C. Hovering a chip shows its `note` in the cursor label (sentence case),
// or its `image` (e.g. the box itself) with the note as caption.
// variant 'cards': each item becomes a box with its note visible (channels, roles).
//   <Chips label="Must-haves" intro="What the service could not do without."
//     items={[{ label: 'Balanced diet', note: '…', color?: '#ffa91e', image?: imported }]} />
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  intro?: string;
  variant?: 'chips' | 'cards';
  items: { label: string; note?: string; color?: string; image?: ImageMetadata }[];
}
const { label, intro, variant = 'chips', items } = Astro.props;
const rows = await Promise.all(
  items.map(async (it) => ({
    ...it,
    src: it.image ? (await getImage({ src: it.image, width: 480, format: 'webp' })).src : undefined,
  })),
);
---

<div class:list={['chips', 'trio', `chips--${variant}`]} data-reveal>
  <div class="chips__head">
    <p class="label label--group">{label}</p>
    {intro && <p class="chips__intro">{intro}</p>}
  </div>
  <ul class="chips__list span-2">
    {
      rows.map((c, i) => (
        <li
          class:list={['chip', { 'has-hover': variant === 'cards' ? c.src : c.note || c.src }]}
          data-cursor={variant === 'cards' ? (c.src ? c.label : undefined) : c.note || (c.src ? c.label : undefined)}
          data-cursor-style={variant !== 'cards' && c.note && !c.src ? 'note' : undefined}
          data-cursor-image={c.src}
        >
          {variant === 'cards' && <span class="chip__n label">{String(i + 1).padStart(2, '0')}</span>}
          <span class="chip__title">
            {c.color && <span class="chip__swatch" style={`background: ${c.color}`} aria-hidden="true" />}
            {c.label}
          </span>
          {variant === 'cards' && c.note && <span class="chip__note">{c.note}</span>}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .chips {
    row-gap: var(--space-3);
    align-items: start;
  }

  .chips__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .chips__intro {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
    max-width: 30ch;
  }

  .chips__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .chip {
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 16px 13px;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    transition:
      border-color 0.25s,
      background 0.25s;
  }

  .chip.has-hover:hover {
    border-color: var(--ink);
    background: var(--paper-2);
  }

  .chip__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .chip__swatch {
    width: 12px;
    height: 12px;
    flex: none;
  }

  /* Cards: a two-column grid of boxes, each with its role visible. */
  .chips--cards .chips__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1);
  }

  .chips--cards .chip {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-3);
  }

  .chip__n {
    color: var(--signal);
  }

  .chips--cards .chip__title {
    font-size: var(--fs-lead);
    letter-spacing: -0.015em;
  }

  .chip__note {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .chips--cards .chips__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
// A short list pulled out of a sentence, as a light row: the group label and one line of context on track A,
// the items as plain lines on tracks B–C (cards: cells, two per row). Hovering an item shows its `note` in the
// cursor label (sentence case), or its `image` (e.g. the box itself) with the note as caption.
// variant 'cards': each item becomes a box with its note visible (channels, roles).
//   <Chips label="Must-haves" intro="What the service could not do without."
//     items={[{ label: 'Balanced diet', note: '…', color?: '#ffa91e', image?: imported }]} />
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label?: string;
  intro?: string;
  variant?: 'chips' | 'cards';
  items: { label: string; note?: string; color?: string; image?: ImageMetadata }[];
}
const { label, intro, variant = 'chips', items } = Astro.props;
const rows = await Promise.all(
  items.map(async (it) => ({
    ...it,
    src: it.image ? (await getImage({ src: it.image, width: 480, format: 'webp' })).src : undefined,
  })),
);
---

<div class:list={['chips', `chips--${variant}`]} data-reveal>
  {
    (label || intro) && (
      <div class="chips__head">
        {label && <p class="label label--group">{label}</p>}
        {intro && <p class="chips__intro">{intro}</p>}
      </div>
    )
  }
  <ul class="chips__list" style={variant === 'cards' ? `--cols: ${items.length % 3 === 0 ? 3 : 2}` : undefined}>
    {
      rows.map((c, i) => (
        <li
          class:list={['chip', { 'has-hover': variant === 'cards' ? c.src : c.note || c.src }]}
          data-cursor={variant === 'cards' ? (c.src ? c.label : undefined) : c.note || (c.src ? c.label : undefined)}
          data-cursor-style={variant !== 'cards' && c.note && !c.src ? 'note' : undefined}
          data-cursor-image={c.src}
        >
          {variant === 'cards' && <span class="chip__n label">{String(i + 1).padStart(2, '0')}</span>}
          <span class="chip__title">
            {c.color && <span class="chip__swatch" style={`background: ${c.color}`} aria-hidden="true" />}
            {c.label}
          </span>
          {variant === 'cards' && c.note && <span class="chip__note">{c.note}</span>}
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Chips (default): a light row, no boxes. The label and its line of context on track A, the items as
     plain lines on tracks B–C. Hovering an item still shows its note in the cursor label. */
  .chips--chips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  :global(.prose) > .chips--chips + .chips--chips {
    margin-top: var(--space-4);
  }

  .chips__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .chips__intro {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
  }

  .chips--chips .chips__list {
    grid-column: span 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-2);
    align-content: start;
  }

  .chip {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .chip__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .chip__swatch {
    width: 12px;
    height: 12px;
    flex: none;
  }

  /* Cards: cells across the body lane (thirds for 3 or 6 items, halves otherwise), note visible. */
  .chips--cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .chips--cards .chips__list {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }

  .chips--cards .chip {
    gap: var(--space-2);
    min-height: 200px;
    padding: var(--space-3);
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .chip__n {
    color: var(--signal);
  }

  .chip__note {
    margin-top: auto;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .chips--chips {
      grid-template-columns: minmax(0, 1fr);
    }

    .chips--chips .chips__list {
      grid-column: auto;
      grid-template-columns: minmax(0, 1fr);
    }

    .chips--cards .chips__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .chips--cards .chip {
      min-height: 0;
    }
  }
</style>

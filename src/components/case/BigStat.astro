---
// The one number a chapter hinges on, as a full-width cell: the number on top, its caption and source pinned
// to the bottom. Same size as every other number; a <Metrics> row right after it joins the same cell grid.
//   <BigStat value="92%" label="of off-site students change their eating habits after moving out" source="Lupi et al., 2015" />
import Stat from './Stat.astro';

interface Props {
  value: string;
  label: string;
  source?: string;
}
const { value, label, source } = Astro.props;
---

<figure class="bigstat cells" data-reveal>
  <div class="cell bigstat__cell">
    <Stat value={value} />
    <figcaption class="cell__foot bigstat__cap">
      <p class="bigstat__label">{label}</p>
      {source && <p class="bigstat__source">Source: {source}</p>}
    </figcaption>
  </div>
</figure>

<style>
  .bigstat {
    margin: 0;
  }

  .bigstat__cell {
    grid-column: 1 / -1;
    gap: var(--space-5);
  }

  .bigstat__cap {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 40ch;
  }

  .bigstat__label {
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }

  .bigstat__source {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-3);
  }
</style>

---
// Project cover. Renders the real media (image or looping video) when provided,
// otherwise a designed typographic placeholder in the project's tone.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
  sizes?: string;
}

const { project, eager = false, sizes = '(min-width: 1100px) 66vw, 100vw' } = Astro.props;
const { title, tone, toneDark, cover } = project.data;
const hasMedia = Boolean(cover?.image || cover?.video);
---

<div
  class:list={['cover', { 'cover--dark': toneDark, 'cover--media': hasMedia }]}
  style={`--tone: ${tone}`}
>
  {
    cover?.video ? (
      <video
        class="cover__media"
        src={cover.video}
        poster={cover.image?.src}
        muted
        loop
        playsinline
        preload="metadata"
        data-autoplay
        aria-label={cover.alt || title}
      />
    ) : cover?.image ? (
      <Image
        class="cover__media"
        src={cover.image}
        alt={cover.alt}
        widths={[640, 960, 1280, 1920, 2400]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <div class="cover__ph" aria-hidden="true">
        <span class="cover__grid" />
        <span class="cover__corner cover__corner--tl reg" />
        <span class="cover__corner cover__corner--tr reg" />
        <span class="cover__corner cover__corner--bl reg" />
        <span class="cover__corner cover__corner--br reg" />
        <span class="cover__title">{title}</span>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--tone, var(--paper-2));
    color: var(--ink);
    isolation: isolate;
  }

  .cover--dark {
    color: var(--paper);
  }

  .cover__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }

  .cover__ph {
    position: absolute;
    inset: 0;
    transition: transform 1.4s var(--ease-out);
  }

  :global(a:hover) .cover__media,
  :global(a:hover) .cover__ph {
    transform: scale(1.025);
  }

  .cover__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px);
    background-size: calc(100% / 16) calc(100% / 10);
    mask-image: radial-gradient(ellipse at 50% 55%, #000 30%, transparent 85%);
  }

  .cover__corner {
    position: absolute;
    width: 13px;
    height: 13px;
    opacity: 0.6;
  }

  .cover__corner--tl {
    top: 18px;
    left: 18px;
  }
  .cover__corner--tr {
    top: 18px;
    right: 18px;
  }
  .cover__corner--bl {
    bottom: 18px;
    left: 18px;
  }
  .cover__corner--br {
    bottom: 18px;
    right: 18px;
  }

  .cover__title {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    text-align: center;
    font-size: clamp(2rem, 7.2cqi, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .cover {
    container-type: inline-size;
  }

  @media (max-width: 560px) {
    .cover__corner {
      width: 9px;
      height: 9px;
    }
  }
</style>

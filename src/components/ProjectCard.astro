---
// Sits in the body lane (cols 4–12). Cover spans all three tracks; below it one
// left-aligned text block in tracks A–B: an eyebrow with the project facts
// (same mono label used above titles across the site), the title, the tagline.
import Cover from './Cover.astro';
import { hrefOf, slugOf, type Project } from '../lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { title, tagline, role, type, year, placeholder } = project.data;
const facts = [type, year, role];
---

<article class="pcard" id={`p-${slugOf(project)}`}>
  <a href={hrefOf(project)} class="pcard__link" data-cursor="Read case study">
    <div class="pcard__cover" data-reveal="clip">
      <Cover project={project} eager={eager} sizes="(min-width: 960px) 72vw, 100vw" />
    </div>

    <div class="pcard__info trio">
      <div class="pcard__text span-2">
        <p class="pcard__facts label">
          {
            facts.map((f, i) => (
              <>
                {i > 0 && <span aria-hidden="true">·</span>}
                <span>{f}</span>
              </>
            ))
          }
          {
            placeholder && (
              <>
                <span aria-hidden="true">·</span>
                <span class="pcard__status">
                  <span class="dot" />
                  In progress
                </span>
              </>
            )
          }
        </p>
        <h3 class="pcard__title">{title}</h3>
        <p class="pcard__tagline">{tagline}</p>
      </div>
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: block;
  }

  .pcard__cover {
    overflow: hidden;
  }

  .pcard__info {
    padding-top: var(--space-3);
  }

  .pcard__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .pcard__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--space-1);
    color: var(--ink-3);
    text-box: trim-both cap alphabetic;
  }

  .pcard__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .pcard__title {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .pcard__tagline {
    max-width: 46ch;
    color: var(--ink-2);
  }
</style>

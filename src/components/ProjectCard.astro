---
// Sits in the body lane (cols 4–12). Cover spans all three tracks; below it the same
// row pattern used across the site: item title in track A, description in tracks B–C.
// Project facts live in the Work index (desktop); on smaller screens, where the index
// is hidden, they appear as one quiet line under the description.
import Cover from './Cover.astro';
import { hrefOf, slugOf, type Project } from '../lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { title, tagline, role, type, year } = project.data;
---

<article class="pcard" id={`p-${slugOf(project)}`}>
  <a href={hrefOf(project)} class="pcard__link" data-cursor="Read case study">
    <div class="pcard__cover" data-reveal="clip">
      <Cover project={project} eager={eager} sizes="(min-width: 960px) 72vw, 100vw" />
    </div>

    <div class="pcard__info trio">
      <h3 class="pcard__title h3 trim">{title}</h3>
      <div class="pcard__text span-2">
        <p class="trim">{tagline}</p>
        <p class="pcard__facts">{type}, {year} — {role}</p>
      </div>
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: block;
  }

  .pcard__cover {
    overflow: hidden;
  }

  .pcard__info {
    padding-top: var(--space-3);
    row-gap: var(--space-2);
  }

  .pcard__text {
    color: var(--ink-2);
  }

  .pcard__text > p:first-child {
    max-width: 58ch;
  }

  .pcard__facts {
    display: none;
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  @media (max-width: 960px) {
    .pcard__facts {
      display: block;
    }
  }
</style>

---
// Project card for the Work grid: a Card with the project cover as media.
import Card from './Card.astro';
import Cover from './Cover.astro';
import { hrefOf, slugOf, type Project } from '../lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { title, year, type, platform } = project.data;
---

<Card
  id={`p-${slugOf(project)}`}
  title={title}
  year={year}
  meta={`${type}, ${platform}`}
  href={hrefOf(project)}
  cursor="Read case study"
  tone={project.data.tone}
>
  <Cover project={project} eager={eager} sizes="(min-width: 960px) 90vw, 100vw" />
</Card>

---
// Sits in the body lane (cols 4–12). Cover spans all three tracks.
// Below it, two rows mirror each other: title | type · year, tagline | role · status.
// Left items take tracks A–B; the facts sit in track C, right-aligned to the cover edge
// and on the same baselines as the title and tagline.
import Cover from './Cover.astro';
import { hrefOf, slugOf, type Project } from '../lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { title, tagline, role, type, year, placeholder } = project.data;
---

<article class="pcard" id={`p-${slugOf(project)}`}>
  <a href={hrefOf(project)} class="pcard__link" data-cursor="Read case study">
    <div class="pcard__cover" data-reveal="clip">
      <Cover project={project} eager={eager} sizes="(min-width: 960px) 72vw, 100vw" />
    </div>

    <div class="pcard__info trio">
      <h3 class="pcard__title span-2">{title}</h3>
      <p class="pcard__meta label">
        <span>{type}</span>
        <span aria-hidden="true">·</span>
        <span>{year}</span>
      </p>

      <p class="pcard__tagline span-2">{tagline}</p>
      <p class="pcard__role">
        <span class="visually-hidden">Role: </span>{role}
        {
          placeholder && (
            <span class="pcard__status">
              <span class="dot" /> In progress
            </span>
          )
        }
      </p>
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: block;
  }

  .pcard__cover {
    overflow: hidden;
  }

  .pcard__info {
    padding-top: var(--space-3);
    row-gap: var(--space-2);
    align-items: baseline;
  }

  .pcard__title {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .pcard__tagline {
    max-width: 44ch;
    color: var(--ink-2);
  }

  .pcard__meta,
  .pcard__role {
    justify-self: end;
    text-align: right;
  }

  .pcard__meta {
    display: flex;
    gap: var(--space-1);
    color: var(--ink-3);
  }

  .pcard__role {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .pcard__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .pcard__info {
      row-gap: var(--space-1);
    }

    .pcard__meta {
      order: -1;
    }

    .pcard__meta,
    .pcard__role {
      justify-self: start;
      text-align: left;
      align-items: flex-start;
    }

    .pcard__role {
      margin-top: var(--space-1);
    }
  }
</style>

---
// Sits in the body lane (cols 4–12). Cover spans all three tracks;
// title + tagline take tracks A–B, facts take track C.
import Cover from './Cover.astro';
import { hrefOf, slugOf, type Project } from '../lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { title, tagline, role, type, year, placeholder } = project.data;
---

<article class="pcard" id={`p-${slugOf(project)}`}>
  <a href={hrefOf(project)} class="pcard__link" data-cursor="Read case study">
    <div class="pcard__cover" data-reveal="clip">
      <Cover project={project} eager={eager} sizes="(min-width: 960px) 72vw, 100vw" />
    </div>

    <div class="pcard__info trio">
      <div class="pcard__main span-2">
        <h3 class="pcard__title trim">{title}</h3>
        <p class="pcard__tagline">{tagline}</p>
        <span class="pcard__cta label">Read case study <span class="arrow" aria-hidden="true">→</span></span>
      </div>

      <dl class="facts pcard__facts">
        <div><dt class="label muted">Role</dt><dd>{role}</dd></div>
        <div><dt class="label muted">Type</dt><dd>{type}</dd></div>
        <div><dt class="label muted">Year</dt><dd>{year}</dd></div>
        {
          placeholder && (
            <div>
              <dt class="label muted">Status</dt>
              <dd class="pcard__status">
                <span class="dot" /> In progress
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: block;
  }

  .pcard__cover {
    overflow: hidden;
  }

  .pcard__info {
    padding-top: var(--space-3);
    row-gap: var(--space-4);
  }

  .pcard__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .pcard__title {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .pcard__tagline {
    max-width: 44ch;
    color: var(--ink-2);
  }

  .pcard__cta {
    margin-top: var(--space-1);
    color: var(--ink-3);
    transition: color 0.25s;
  }

  .pcard__link:hover .pcard__cta {
    color: var(--ink);
  }

  /* Quiet key/value block: no rules, two aligned columns, tight rhythm */
  .pcard__facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    align-items: baseline;
    align-content: start;
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .pcard__facts > div {
    display: contents;
  }

  .pcard__facts dt {
    margin: 0;
  }

  .pcard__facts > div:first-child > * {
    text-box: trim-start cap alphabetic;
  }

  .pcard__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>

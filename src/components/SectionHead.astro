---
interface Props {
  index: string;
  title: string;
  aside?: string;
  id?: string;
}
const { index, title, aside, id } = Astro.props;
---

<header class="shead">
  <div class="shead__rule" data-reveal="rule"></div>
  <div class="grid shead__row">
    <span class="shead__idx label">({index})</span>
    <h2 class="shead__title h2" id={id} data-reveal>{title}</h2>
    {aside && <span class="shead__aside label muted">{aside}</span>}
  </div>
</header>

<style>
  .shead {
    margin-bottom: clamp(40px, 6vw, 88px);
  }

  .shead__rule {
    height: 1px;
    background: var(--rule-strong);
  }

  .shead__row {
    padding-top: 14px;
    align-items: start;
  }

  .shead__idx {
    grid-column: 1 / span 3;
    color: var(--signal);
    padding-top: 0.5em;
  }

  .shead__title {
    grid-column: 4 / span 7;
  }

  .shead__aside {
    grid-column: 11 / span 2;
    text-align: right;
    padding-top: 0.5em;
  }

  @media (max-width: 720px) {
    .shead__idx {
      grid-column: 1 / span 6;
    }

    .shead__aside {
      grid-column: 7 / span 6;
      grid-row: 1;
    }

    .shead__title {
      grid-column: 1 / -1;
      margin-top: 20px;
    }
  }
</style>

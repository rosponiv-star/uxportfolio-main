---
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header" data-header>
  <div class="wrap header__inner">
    <a href="/" class="header__name">{site.name}</a>

    <nav aria-label="Primary">
      <ul class="header__nav">
        {
          nav.map((item, i) => {
            const active = item.match(path);
            // Not ready yet: visible, greyed, not a link; "Soon" takes the micro-number's place.
            if (item.soon) {
              return (
                <li>
                  <span
                    class="header__link header__link--soon"
                    aria-disabled="true"
                    data-cursor="Coming soon"
                    data-cursor-style="soon"
                  >
                    <span class="header__idx header__idx--soon label">Soon</span>
                    <span>{item.label}</span>
                  </span>
                </li>
              );
            }
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['header__link', { 'is-active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  <span class="header__idx label" aria-hidden="true">
                    0{i + 1}
                  </span>
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition:
      transform 0.6s var(--ease-out),
      border-color 0.3s;
    view-transition-name: site-header;
  }

  :global([data-scrolled]) .header {
    border-bottom-color: var(--rule);
  }

  :global([data-header-hidden]) .header {
    transform: translateY(-100%);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .header__name,
  .header__link {
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .header__nav {
    display: flex;
    gap: var(--space-4);
  }

  .header__link {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--ink-3);
    transition: color 0.25s;
  }

  .header__idx {
    font-size: 0.625rem;
    color: var(--ink-4);
    transform: translateY(-0.45em);
    transition: color 0.25s;
  }

  .header__link.is-active .header__idx {
    color: var(--signal);
  }

  .header__link:hover,
  .header__link.is-active {
    color: var(--ink);
  }

  .header__link--soon,
  .header__link--soon:hover {
    color: var(--ink-4);
    cursor: default;
  }

  .header__idx--soon {
    color: var(--soon);
  }

  @media (max-width: 520px) {
    .header__name {
      white-space: nowrap;
    }

    .header__nav {
      gap: var(--space-2);
    }

    .header__idx:not(.header__idx--soon) {
      display: none;
    }

    /* No room beside the word: "Soon" sits just above it, taking no width. */
    .header__link--soon {
      position: relative;
    }

    .header__idx--soon {
      position: absolute;
      left: 0;
      bottom: 100%;
      transform: none;
      line-height: 1;
    }
  }
</style>

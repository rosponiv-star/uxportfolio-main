---
// Generic collection card. The media (slot) fills the card; title, type and year sit inside it
// and appear on hover/focus over a flat scrim (legible on any cover). Without hover (touch),
// the text stays visible below the media instead.
// The media ratio comes from the grid slot (--card-ratio). With `href` the whole card is a link.
interface Props {
  title: string;
  year?: string;
  meta?: string;
  href?: string;
  cursor?: string;
  id?: string;
}
const { title, year, meta, href, cursor, id } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<article class="card" id={id} data-reveal="card">
  <Tag class="card__link" href={href} data-cursor={href ? cursor : undefined}>
    <div class="card__media">
      <slot />
    </div>
    <div class="card__info">
      <h3 class="card__title">{title}</h3>
      <p class="card__meta">
        {meta && <span class="card__type">{meta}</span>}
        {year && <span class="card__year">{year}</span>}
      </p>
    </div>
  </Tag>
</article>

<style>
  .card__link {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .card__media {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 3);
    overflow: hidden;
    background: var(--paper-2);
  }

  .card__media > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .card__title {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .card__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-small);
  }

  .card__type {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card__year {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  /* Entrance (footprint never changes): the cover fades in at full size while the image
     settles from a slight zoom. Driven by .is-in on [data-reveal='card']; --card-delay staggers. */
  :global(.js) .card .card__media {
    opacity: 0;
    transition: opacity 1s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card .card__media > :global(*) {
    transform: scale(1.06);
    transition: transform 1.6s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card:global(.is-in) .card__media {
    opacity: 1;
  }

  :global(.js) .card:global(.is-in) .card__media > :global(*) {
    transform: none;
  }

  /* Hover devices: text inside the card, revealed over a flat scrim */
  @media (hover: hover) and (pointer: fine) {
    .card__link::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgb(17 17 17 / 0.5);
      opacity: 0;
      transition: opacity 0.6s var(--ease-out);
      pointer-events: none;
    }

    .card__info {
      position: absolute;
      z-index: 1;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-4);
      color: var(--paper);
      pointer-events: none;
    }

    .card__title,
    .card__meta {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s var(--ease-out),
        transform 0.7s var(--ease-out);
    }

    .card__meta {
      color: rgb(252 252 251 / 0.78);
    }

    .card__year {
      color: rgb(252 252 251 / 0.55);
    }

    .card__media > :global(*) {
      transition: transform 1.2s var(--ease-out);
    }

    /* Hover / keyboard focus */
    .card__link:hover::after,
    .card__link:focus-visible::after {
      opacity: 1;
    }

    .card__link:hover .card__title,
    .card__link:focus-visible .card__title {
      opacity: 1;
      transform: none;
      transition-delay: 0.06s;
    }

    .card__link:hover .card__meta,
    .card__link:focus-visible .card__meta {
      opacity: 1;
      transform: none;
      transition-delay: 0.14s;
    }

    :global(.js) .card:global(.is-in) .card__link:hover .card__media > :global(*),
    .card__link:hover .card__media > :global(*) {
      transform: scale(1.03);
    }
  }

  /* Touch devices: text below the media */
  @media not ((hover: hover) and (pointer: fine)) {
    .card__info {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding-top: var(--space-2);
    }

    .card__meta {
      color: var(--ink-3);
    }

    .card__year {
      color: var(--ink-4);
    }
  }
</style>

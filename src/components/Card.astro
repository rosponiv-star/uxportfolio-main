---
// Generic collection card: media (slot), then the title and a grey line with type and year.
// The media ratio comes from the grid slot (--card-ratio). With `href` the whole card is a link.
interface Props {
  title: string;
  year?: string;
  meta?: string;
  href?: string;
  cursor?: string;
  id?: string;
}
const { title, year, meta, href, cursor, id } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<article class="card" id={id} data-reveal="card">
  <Tag class="card__link" href={href} data-cursor={href ? cursor : undefined}>
    <div class="card__media">
      <slot />
    </div>
    <div class="card__info">
      <h3 class="card__title">{title}</h3>
      <p class="card__meta">
        {meta && <span class="card__type">{meta}</span>}
        {year && <span class="card__year">{year}</span>}
      </p>
    </div>
  </Tag>
</article>

<style>
  /* Entrance (no change of footprint): the cover fades in at full size while the image inside
     settles from a slight zoom; then title and meta rise a few pixels in sequence.
     Driven by .is-in on [data-reveal='card'] (scripts/site.ts). Delay via --card-delay. */
  :global(.js) .card .card__media {
    opacity: 0;
    transition: opacity 1s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card .card__media > :global(*) {
    transform: scale(1.06);
    transition: transform 1.6s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card .card__title,
  :global(.js) .card .card__meta {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
  }

  :global(.js) .card .card__title {
    transition-delay: calc(var(--card-delay, 0ms) + 250ms);
  }

  :global(.js) .card .card__meta {
    transition-delay: calc(var(--card-delay, 0ms) + 350ms);
  }

  :global(.js) .card:global(.is-in) .card__media,
  :global(.js) .card:global(.is-in) .card__title,
  :global(.js) .card:global(.is-in) .card__meta {
    opacity: 1;
    transform: none;
  }

  :global(.js) .card:global(.is-in) .card__media > :global(*) {
    transform: none;
  }

  .card__link {
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 3);
    overflow: hidden;
    background: var(--paper-2);
  }

  .card__media > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-3);
  }

  .card__title {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .card__year {
    flex: none;
    color: var(--ink-4);
    font-variant-numeric: tabular-nums;
  }

  /* One line, so media in the same row always start at the same height */
  .card__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .card__type {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

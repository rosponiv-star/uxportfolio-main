---
// Generic collection card. The media (slot) fills the card.
// Linked cards on hover devices: on hover/focus the media zooms out slightly over the card's
// tone and the facts rise in as square paper chips at the bottom-left (title, type, year).
// Touch devices and cards without a link keep the text below the media.
// The media ratio comes from the grid slot (--card-ratio). With `href` the whole card is a link.
interface Props {
  title: string;
  year?: string;
  meta?: string;
  href?: string;
  cursor?: string;
  id?: string;
  tone?: string;
}
const { title, year, meta, href, cursor, id, tone } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<article
  class:list={['card', { 'card--linked': href }]}
  id={id}
  data-reveal="card"
  style={tone ? `--card-bg: ${tone}` : undefined}
>
  <Tag class="card__link" href={href} data-cursor={href ? cursor : undefined}>
    <div class="card__media">
      <slot />
    </div>
    <div class="card__info">
      <h3 class="card__title">{title}</h3>
      {meta && <span class="card__type">{meta}</span>}
      {year && <span class="card__year">{year}</span>}
    </div>
  </Tag>
</article>

<style>
  .card__link {
    position: relative;
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 3);
    overflow: hidden;
    background: var(--card-bg, var(--paper-2));
  }

  .card__media > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  /* Default (touch, unlinked): text below the media. */
  .card__info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    padding-top: var(--space-2);
  }

  .card__title {
    flex-basis: 100%;
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .card__type,
  .card__year {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .card__type {
    min-width: 0;
  }

  .card__year {
    color: var(--ink-4);
    font-variant-numeric: tabular-nums;
  }

  /* Entrance (footprint never changes): the cover fades in at full size while the image
     settles from a slight zoom. Driven by .is-in on [data-reveal='card']; --card-delay staggers. */
  :global(.js) .card .card__media {
    opacity: 0;
    transition: opacity 1s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card .card__media > :global(*) {
    transform: scale(1.06);
    transition: transform 1.6s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card:global(.is-in) .card__media {
    opacity: 1;
  }

  :global(.js) .card:global(.is-in) .card__media > :global(*) {
    transform: none;
  }

  /* Hover devices, linked cards: the cover zooms out a touch over the tone, and the facts
     rise in as chips. The image is never darkened. */
  @media (hover: hover) and (pointer: fine) {
    .card--linked .card__info {
      position: absolute;
      z-index: 1;
      left: var(--space-2);
      right: var(--space-2);
      bottom: var(--space-2);
      align-items: stretch;
      gap: 6px;
      padding: 0;
      pointer-events: none;
    }

    .card--linked .card__title,
    .card--linked .card__type,
    .card--linked .card__year {
      flex-basis: auto;
      padding: 7px 11px 8px;
      background: var(--paper);
      box-shadow: inset 0 0 0 1px var(--rule);
      font-size: var(--fs-small);
      line-height: 1.2;
      letter-spacing: -0.005em;
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.4s var(--ease-out),
        transform 0.6s var(--ease-out);
    }

    .card--linked .card__title {
      font-weight: 500;
      color: var(--ink);
    }

    .card--linked .card__type {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .card--linked .card__media > :global(*) {
      transition: transform 0.9s var(--ease-out);
    }

    .card--linked .card__link:is(:hover, :focus-visible) .card__info > * {
      opacity: 1;
      transform: none;
    }

    .card--linked .card__link:is(:hover, :focus-visible) .card__title {
      transition-delay: 0.06s;
    }

    .card--linked .card__link:is(:hover, :focus-visible) .card__type {
      transition-delay: 0.12s;
    }

    .card--linked .card__link:is(:hover, :focus-visible) .card__year {
      transition-delay: 0.18s;
    }

    :global(.js) .card:global(.is-in) .card__link:is(:hover, :focus-visible) .card__media > :global(*),
    .card--linked .card__link:is(:hover, :focus-visible) .card__media > :global(*) {
      transform: scale(0.95);
    }

    /* The cover's own hover zoom would fight the zoom-out. */
    .card--linked .card__link:hover .card__media :global(.cover__media),
    .card--linked .card__link:hover .card__media :global(.cover__ph) {
      transform: none;
    }
  }
</style>

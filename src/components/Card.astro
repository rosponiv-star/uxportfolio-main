---
// Generic collection card: title with the year on the right and a grey meta line above the media (slot),
// so the eye reads what a project is before looking at it.
// The media ratio comes from the grid slot (--card-ratio). With `href` the whole card is a link.
interface Props {
  title: string;
  year?: string;
  meta?: string;
  href?: string;
  cursor?: string;
  id?: string;
}
const { title, year, meta, href, cursor, id } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<article class="card" id={id}>
  <Tag class="card__link" href={href} data-cursor={href ? cursor : undefined}>
    <div class="card__info">
      <h3 class="card__title">{title}</h3>
      {year && <span class="card__year">{year}</span>}
      {meta && <p class="card__meta">{meta}</p>}
    </div>
    <div class="card__media" data-reveal="clip">
      <slot />
    </div>
  </Tag>
</article>

<style>
  .card__link {
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 3);
    overflow: hidden;
    background: var(--paper-2);
  }

  .card__media > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .card__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-3);
    row-gap: 6px;
    align-items: baseline;
    padding-bottom: var(--space-2);
  }

  .card__title {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .card__year {
    font-size: var(--fs-small);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* One line, so media in the same row always start at the same height */
  .card__meta {
    grid-column: 1 / -1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
</style>

---
// Generic collection card. The media (slot) fills the card and nothing ever covers it.
// Linked cards on hover devices: title, type and year travel with the pointer inside the
// cursor label (scripts/site.ts, data-cursor-*), above the action. Keyboard focus shows the
// same label pinned to the card's bottom-left corner. Touch devices and cards without a link
// keep the text below the media.
// The media ratio comes from the grid slot (--card-ratio). With `href` the whole card is a link.
interface Props {
  title: string;
  year?: string;
  meta?: string;
  href?: string;
  cursor?: string;
  id?: string;
}
const { title, year, meta, href, cursor, id } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<article class:list={['card', { 'card--linked': href }]} id={id} data-reveal="card">
  <Tag
    class="card__link"
    href={href}
    data-cursor={href ? cursor : undefined}
    data-cursor-title={href ? title : undefined}
    data-cursor-meta={href ? meta : undefined}
    data-cursor-year={href ? year : undefined}
  >
    <div class="card__media">
      <slot />
    </div>
    <div class="card__info">
      <h3 class="card__title">{title}</h3>
      <p class="card__meta">
        {meta && <span class="card__type">{meta}</span>}
        {year && <span class="card__year">{year}</span>}
      </p>
      {href && cursor && <span class="card__action">{cursor}</span>}
    </div>
  </Tag>
</article>

<style>
  .card__link {
    position: relative;
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 3);
    overflow: hidden;
    background: var(--paper-2);
  }

  .card__media > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-2);
  }

  .card__title {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .card__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .card__type {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card__year {
    flex: none;
    color: var(--ink-4);
    font-variant-numeric: tabular-nums;
  }

  .card__action {
    display: none;
  }

  /* Entrance (footprint never changes): the cover fades in at full size while the image
     settles from a slight zoom. Driven by .is-in on [data-reveal='card']; --card-delay staggers. */
  :global(.js) .card .card__media {
    opacity: 0;
    transition: opacity 1s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card .card__media > :global(*) {
    transform: scale(1.06);
    transition: transform 1.6s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card:global(.is-in) .card__media {
    opacity: 1;
  }

  :global(.js) .card:global(.is-in) .card__media > :global(*) {
    transform: none;
  }

  /* Hover devices, linked cards: the text lives in the cursor label, so the card is the cover
     alone. The info stays in the DOM for screen readers and appears, styled like the cursor
     label, only on keyboard focus. */
  @media (hover: hover) and (pointer: fine) {
    .card--linked .card__info {
      position: absolute;
      left: var(--space-2);
      bottom: var(--space-2);
      z-index: 1;
      width: max-content;
      max-width: calc(100% - var(--space-4));
      gap: 0;
      padding: 0;
      background: var(--ink);
      color: var(--paper);
      clip-path: inset(50%);
      pointer-events: none;
    }

    .card--linked .card__link:focus-visible .card__info {
      clip-path: none;
    }

    .card--linked .card__title {
      padding: 10px 12px 0;
      font-size: var(--fs-small);
    }

    .card--linked .card__meta {
      padding: 2px 12px 10px;
      font-size: var(--fs-label);
      color: color-mix(in srgb, var(--paper) 70%, transparent);
    }

    .card--linked .card__year {
      color: color-mix(in srgb, var(--paper) 50%, transparent);
    }

    .card--linked .card__action {
      display: block;
      padding: 8px 12px 7px;
      border-top: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
      font-size: var(--fs-label);
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .card--linked .card__media > :global(*) {
      transition: transform 1.2s var(--ease-out);
    }

    :global(.js) .card:global(.is-in) .card__link:hover .card__media > :global(*),
    .card__link:hover .card__media > :global(*) {
      transform: scale(1.03);
    }
  }
</style>

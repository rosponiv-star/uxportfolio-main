---
// Generic collection card. The media (slot) fills the card; title, type and year sit inside it
// on a paper caption bar that slides up on hover/focus (no darkening). As the bar rises, the
// media shrinks towards the top edge by exactly the bar's height, so the bar never covers it;
// `tone` fills the card behind the shrunk media. Without hover (touch), the text stays below.
// The media ratio comes from the grid slot (--card-ratio). With `href` the whole card is a link.
interface Props {
  title: string;
  year?: string;
  meta?: string;
  href?: string;
  cursor?: string;
  id?: string;
  tone?: string;
}
const { title, year, meta, href, cursor, id, tone } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<article class="card" id={id} data-reveal="card" style={tone ? `--card-bg: ${tone}` : undefined}>
  <Tag class="card__link" href={href} data-cursor={href ? cursor : undefined}>
    <div class="card__media">
      <slot />
    </div>
    <div class="card__info">
      <h3 class="card__title">{title}</h3>
      <p class="card__meta">
        {meta && <span class="card__type">{meta}</span>}
        {year && <span class="card__year">{year}</span>}
      </p>
    </div>
  </Tag>
</article>

<style>
  .card__link {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .card__media {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 3);
    overflow: hidden;
    background: var(--card-bg, var(--paper-2));
  }

  .card__media > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .card__title {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .card__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-small);
  }

  .card__type {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card__year {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  /* Entrance (footprint never changes): the cover fades in at full size while the image
     settles from a slight zoom. Driven by .is-in on [data-reveal='card']; --card-delay staggers. */
  :global(.js) .card .card__media {
    opacity: 0;
    transition: opacity 1s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card .card__media > :global(*) {
    transform: scale(1.06);
    transition: transform 1.6s var(--ease-out) var(--card-delay, 0ms);
  }

  :global(.js) .card:global(.is-in) .card__media {
    opacity: 1;
  }

  :global(.js) .card:global(.is-in) .card__media > :global(*) {
    transform: none;
  }

  /* Hover devices: a paper-coloured caption bar slides up from the bottom edge of the cover,
     carrying the text in ink. The image is never darkened; contrast is the page's own. */
  @media (hover: hover) and (pointer: fine) {
    .card__info {
      position: absolute;
      z-index: 1;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: var(--space-3) var(--space-3) var(--space-3);
      background: var(--paper);
      transform: translateY(101%);
      transition: transform 0.7s var(--ease-out);
      pointer-events: none;
    }

    .card__title,
    .card__meta {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.45s var(--ease-out),
        transform 0.6s var(--ease-out);
    }

    .card__meta {
      color: var(--ink-3);
    }

    .card__year {
      color: var(--ink-4);
    }

    .card__media > :global(*) {
      transform-origin: 50% 0;
      transition: transform 0.7s var(--ease-out);
    }

    /* The cover keeps its own hover zoom out of the card: the shrink is the only motion. */
    .card__link:hover .card__media :global(.cover__media),
    .card__link:hover .card__media :global(.cover__ph) {
      transform: none;
    }

    .card__link:hover .card__info,
    .card__link:focus-visible .card__info {
      transform: none;
    }

    .card__link:hover .card__title,
    .card__link:focus-visible .card__title {
      opacity: 1;
      transform: none;
      transition-delay: 0.12s;
    }

    .card__link:hover .card__meta,
    .card__link:focus-visible .card__meta {
      opacity: 1;
      transform: none;
      transition-delay: 0.2s;
    }

    :global(.js) .card:global(.is-in) .card__link:hover .card__media > :global(*),
    .card__link:hover .card__media > :global(*) {
      transform: scale(var(--card-shrink, 0.84));
    }
  }

  /* Touch devices: text below the media */
  @media not ((hover: hover) and (pointer: fine)) {
    .card__info {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding-top: var(--space-2);
    }

    .card__meta {
      color: var(--ink-3);
    }

    .card__year {
      color: var(--ink-4);
    }
  }
</style>

<script>
  // --card-shrink = share of the media left visible above the caption bar, so the bar
  // takes the freed space instead of covering the cover.
  const fit = (card: HTMLElement) => {
    const media = card.querySelector<HTMLElement>('.card__media');
    const info = card.querySelector<HTMLElement>('.card__info');
    if (!media || !info || !media.offsetHeight) return;
    const s = 1 - info.offsetHeight / media.offsetHeight;
    card.style.setProperty('--card-shrink', Math.max(0.5, s).toFixed(4));
  };
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  document.querySelectorAll<HTMLElement>('.card').forEach((c) => ro.observe(c));
</script>

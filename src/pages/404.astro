---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap grid nf">
    <h1 class="display col-wide">This page is off the grid.</h1>
    <p class="lead col-text">The link may be outdated, or the page has moved.</p>
    <a href="/" class="col-text nf__link">Back to the work <span class="arrow" aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .nf {
    padding-top: calc(var(--header-h) + var(--space-6) * 2);
    row-gap: var(--space-4);
  }
</style>

---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Collection from '../components/Collection.astro';
import DepthTexture from '../components/DepthTexture.astro';
import { CATEGORIES, getProjects, hrefOf, numOf } from '../lib/projects';
import { categoryId, gridSizes } from '../lib/collection';

const projects = await getProjects();

const statement =
  'Valerio Rosponi, UX and digital product designer. Products that solve real problems, crafted to the last detail.';
const words = statement.split(' ');

const sizes = gridSizes(projects.length);
const items = projects.map((p) => ({
  title: p.data.title,
  num: numOf(p),
  year: p.data.year,
  type: p.data.type,
  role: p.data.role,
  cats: p.data.categories as string[],
  href: hrefOf(p),
  project: p,
}));

const principles = [
  {
    title: 'Problem before pixels',
    text: 'I don’t open Figma until I can describe the problem in one sentence and say who has it. Research, data and constraints come first, because they make every later decision easier to defend.',
    practice: ['Desk & competitor research', 'Interviews', 'Problem statements', 'How might we'],
  },
  {
    title: 'Structure is the first interface',
    text: 'Before anything looks good, it has to make sense. I map content, flows and hierarchy early: most usability problems are architecture problems in disguise.',
    practice: ['Information architecture', 'User flows', 'Card sorting', 'Wireframes'],
  },
  {
    title: 'Details are the product',
    text: 'Spacing, states, motion, microcopy. The details are where people decide whether to trust a product, and that trust is what turns a first visit into a habit.',
    practice: ['UI design', 'Interaction states', 'Motion', 'Accessibility checks'],
  },
  {
    title: 'Design as a system',
    text: 'I build components and tokens that scale and that developers can actually ship. Clear specs and a shared language save more time than any handoff tool.',
    practice: ['Design systems', 'Variables & tokens', 'Dev handoff', 'Documentation'],
  },
  {
    title: 'Dare, then prove it',
    text: 'I like exploring interactions and aesthetics that feel new, then putting them in front of people to see if they hold up. Ambition without validation is just decoration.',
    practice: ['Concept exploration', 'Prototyping', 'Usability testing', 'Iteration'],
  },
];
---

<Base>
  <!-- Hero -------------------------------------------------------------- -->
  <section class="hero">
    <DepthTexture intensity={0.5} />
    <div class="wrap grid hero__inner">
      <h1 class="hero__title display col-wide">
        {
          words.map((w, i) => (
            <>
              <span class="w" style={`--i:${i}`}>
                {w}
              </span>{' '}
            </>
          ))
        }
      </h1>
    </div>
  </section>

  <div class="wrap">
    <!-- Work ------------------------------------------------------------ -->
    <Collection id="work" title="Selected work" noun={['project', 'projects']} categories={CATEGORIES} items={items}>
      {
        projects.map((p, i) => (
          <div class="work__slot" data-size={sizes[i]} data-year={p.data.year} data-cats={p.data.categories.map(categoryId).join(' ')}>
            <ProjectCard project={p} eager={i === 0} />
          </div>
        ))
      }
    </Collection>

    <!-- How I work ------------------------------------------------------ -->
    <Section title="How I work" id="process" bodyClass="flow" tone="alt">
      <p class="lead measure" data-reveal>
        Every project asks for a different mix of methods, but the way I think about them stays the same. These are the
        principles I come back to, from the first question to the last pixel.
      </p>

      <ol class="principles">
        {
          principles.map((p, i) => (
            <li class="principle trio">
              <div class="principle__head" data-reveal>
                <span class="label principle__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="h3 trim">{p.title}</h3>
              </div>
              <div class="principle__body span-2" data-reveal style="--d: 1">
                <p class="trim">{p.text}</p>
                <p class="principle__practice">
                  <span class="label muted">In practice</span>
                  <span>{p.practice.join(' · ')}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>
  </div>
</Base>

<style>
  /* Hero ----------------------------------------------------------------- */
  /* Compact: the statement takes only its own space, so Selected work and the top of
     the first project are already visible at scroll 0. The depth texture fills this band. */
  /* The hero is its own tinted band (it holds the depth texture). The change of surface
     separates it from Selected work, so the section below needs no top rule. */
  /* Near full-screen: the band fills the first view except a strip at the bottom that shows
     the Selected work header and the top of the first row of covers, as an invitation to scroll.
     --peek = gap above the section + header height + gap below it + visible slice of cover. */
  .hero {
    --peek: calc(clamp(56px, 9vh, 96px) + var(--work-head, 122px) + var(--space-item) + clamp(56px, 9vh, 96px));
    position: relative;
    display: flex;
    min-height: max(360px, calc(100svh - var(--peek)));
    background: var(--paper-alt);
  }

  .hero + :global(.wrap) > :global(.work) {
    margin-top: clamp(56px, 9vh, 96px);
    padding-top: 0;
    border-top: 0;
  }

  .hero__inner {
    position: relative;
    align-content: center;
    padding-top: calc(var(--header-h) + var(--space-5));
    padding-bottom: var(--space-5);
  }

  /* Statement entrance: each word comes into focus in sequence — fade, de-blur and a
     small rise. No masks, so letters are never cut. fill-mode backwards: hidden during
     the delay, then back to the natural (filter-free) style once done. */
  .w {
    display: inline-block;
    animation: word-in 1.4s var(--ease-out) backwards;
    animation-delay: calc(150ms + var(--i) * 55ms);
  }

  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(0.18em);
    }

    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  /* On narrow screens the filters wrap, so the Selected work header is taller */
  @media (max-width: 960px) {
    .hero {
      --work-head: 180px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w {
      animation: none;
    }
  }

  /* Process -------------------------------------------------------------- */
  .principle {
    padding-block: var(--space-4);
    row-gap: var(--space-2);
  }

  .principle:first-child {
    padding-top: 0;
  }

  .principle + .principle {
    border-top: 1px solid var(--rule);
  }

  .principle__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .principle__n {
    color: var(--signal);
    text-box: trim-both cap alphabetic;
  }

  .principle__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--ink-2);
  }

  .principle__body > p:first-child {
    max-width: 58ch;
  }

  .principle__practice {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
</style>

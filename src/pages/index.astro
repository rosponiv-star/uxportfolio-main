---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RegistrationField from '../components/RegistrationField.astro';
import { getProjects, numOf, slugOf } from '../lib/projects';

const projects = await getProjects();

const statement =
  'Valerio Rosponi, UX and digital product designer. Products that solve real problems, crafted to the last detail.';
const words = statement.split(' ');

const principles = [
  {
    title: 'Problem before pixels',
    text: 'I don’t open Figma until I can describe the problem in one sentence and say who has it. Research, data and constraints come first, because they make every later decision easier to defend.',
    practice: ['Desk & competitor research', 'Interviews', 'Problem statements', 'How might we'],
  },
  {
    title: 'Structure is the first interface',
    text: 'Before anything looks good, it has to make sense. I map content, flows and hierarchy early: most usability problems are architecture problems in disguise.',
    practice: ['Information architecture', 'User flows', 'Card sorting', 'Wireframes'],
  },
  {
    title: 'Details are the product',
    text: 'Spacing, states, motion, microcopy. The details are where people decide whether to trust a product, and that trust is what turns a first visit into a habit.',
    practice: ['UI design', 'Interaction states', 'Motion', 'Accessibility checks'],
  },
  {
    title: 'Design as a system',
    text: 'I build components and tokens that scale and that developers can actually ship. Clear specs and a shared language save more time than any handoff tool.',
    practice: ['Design systems', 'Variables & tokens', 'Dev handoff', 'Documentation'],
  },
  {
    title: 'Dare, then prove it',
    text: 'I like exploring interactions and aesthetics that feel new, then putting them in front of people to see if they hold up. Ambition without validation is just decoration.',
    practice: ['Concept exploration', 'Prototyping', 'Usability testing', 'Iteration'],
  },
];
---

<Base>
  <!-- Hero -------------------------------------------------------------- -->
  <section class="hero">
    <RegistrationField />
    <div class="wrap grid hero__inner">
      <h1 class="hero__title display col-wide">
        {
          words.map((w, i) => (
            <>
              <span class="w" style={`--i:${i}`}>
                {w}
              </span>{' '}
            </>
          ))
        }
      </h1>
    </div>
  </section>

  <div class="wrap">
    <!-- Work ------------------------------------------------------------ -->
    <Section title="Selected work" id="work" class="work" stacked>
      <nav slot="aside" class="work__index" aria-label="Case studies" data-spy>
        <ol>
          {
            projects.map((p) => (
              <li>
                <a href={`#p-${slugOf(p)}`} data-spy-link={`p-${slugOf(p)}`} class="work__index-link">
                  <span class="label">{numOf(p)}</span>
                  <span>{p.data.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="work__list">
        {projects.map((p, i) => <ProjectCard project={p} eager={i === 0} />)}
      </div>
    </Section>

    <!-- How I work ------------------------------------------------------ -->
    <Section title="How I work" id="process" bodyClass="flow" tone="alt">
      <p class="lead measure" data-reveal>
        Every project asks for a different mix of methods, but the way I think about them stays the same. These are the
        principles I come back to, from the first question to the last pixel.
      </p>

      <ol class="principles">
        {
          principles.map((p, i) => (
            <li class="principle trio">
              <div class="principle__head" data-reveal>
                <span class="label principle__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="h3 trim">{p.title}</h3>
              </div>
              <div class="principle__body span-2" data-reveal style="--d: 1">
                <p class="trim">{p.text}</p>
                <p class="principle__practice">
                  <span class="label muted">In practice</span>
                  <span>{p.practice.join(' · ')}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>
  </div>
</Base>

<style>
  /* Hero ----------------------------------------------------------------- */
  /* Scroll 0 shows only the statement; the work is revealed on scroll */
  .hero {
    position: relative;
    display: flex;
    min-height: 100svh;
  }

  .hero__inner {
    position: relative;
    align-content: center;
    padding-block: var(--header-h);
  }

  /* Statement entrance: each word comes into focus in sequence — fade, de-blur and a
     small rise. No masks, so letters are never cut. */
  /* fill-mode backwards: hidden during the delay, then back to the natural (filter-free)
     style once done, so the text isn't left on a blurred compositing layer. */
  .w {
    display: inline-block;
    animation: word-in 1.4s var(--ease-out) backwards;
    animation-delay: calc(150ms + var(--i) * 55ms);
  }

  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(0.18em);
    }

    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w {
      animation: none;
    }
  }

  /* Work ----------------------------------------------------------------- */
  .work__index-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: var(--space-1);
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: var(--fs-small);
    transition:
      color 0.25s,
      padding-left 0.4s var(--ease-out);
  }

  .work__index-link .label {
    min-width: 2ch;
    color: var(--ink-4);
    transition: color 0.25s;
  }

  .work__index li:last-child .work__index-link {
    border-bottom: 1px solid var(--rule);
  }

  .work__index-link:hover,
  .work__index-link:global(.is-active) {
    color: var(--ink);
  }

  .work__index-link:global(.is-active) {
    padding-left: 10px;
  }

  .work__index-link:global(.is-active) .label {
    color: var(--signal);
  }

  .work__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-item);
  }

  /* Process -------------------------------------------------------------- */
  .principle {
    padding-block: var(--space-4);
    row-gap: var(--space-2);
  }

  .principle:first-child {
    padding-top: 0;
  }

  .principle + .principle {
    border-top: 1px solid var(--rule);
  }

  .principle__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .principle__n {
    color: var(--signal);
    text-box: trim-both cap alphabetic;
  }

  .principle__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--ink-2);
  }

  .principle__body > p:first-child {
    max-width: 58ch;
  }

  .principle__practice {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
</style>

---
import Base from '../layouts/Base.astro';
import Collection, { type CollectionItem } from '../components/Collection.astro';
import Card from '../components/Card.astro';
import RegistrationField from '../components/RegistrationField.astro';
import { categoryId, gridSizes } from '../lib/collection';

// Filter vocabulary for experiments, in display order (only categories in use are shown).
const CATEGORIES = ['Interaction', 'Generative', 'Motion', 'Typography', 'Code'] as const;

// Each experiment: card data + which live demo or media to render (see the switch below).
const experiments = [
  {
    key: 'registration-field',
    title: 'Registration field',
    year: '2026',
    type: 'Interactive canvas',
    role: 'Design & code',
    meta: 'Interactive canvas, TypeScript. Move your cursor over it.',
    cats: ['Interaction', 'Code'],
  },
];

const sizes = gridSizes(experiments.length);
const items: CollectionItem[] = experiments.map((e, i) => ({
  title: e.title,
  num: String(i + 1).padStart(2, '0'),
  year: e.year,
  type: e.type,
  role: e.role,
  cats: e.cats,
  tone: 'var(--paper-2)',
}));
---

<Base title="Playground" description="Experiments, side projects and things Valerio Rosponi made for the joy of it.">
  <header class="wrap grid intro">
    <h1 class="display col-wide">Things made for the joy of it.</h1>
    <p class="lead col-text intro__lead">
      No briefs, no stakeholders, no deadlines. Just curiosity, and the occasional bug that turns out to be a feature.
    </p>
  </header>

  <div class="wrap">
    <Collection id="experiments" title="Experiments" noun={['experiment', 'experiments']} categories={CATEGORIES} items={items}>
      {
        experiments.map((e, i) => (
          <div class="work__slot" data-size={sizes[i]} data-year={e.year} data-cats={e.cats.map(categoryId).join(' ')}>
            <Card id={`x-${e.key}`} title={e.title} year={e.year} meta={e.meta}>
              {e.key === 'registration-field' && (
                <div class="stage">
                  <RegistrationField spacing={26} radius={200} />
                </div>
              )}
            </Card>
          </div>
        ))
      }
    </Collection>
  </div>
</Base>

<style>
  .intro {
    padding-top: calc(var(--header-h) + var(--space-6) * 2);
    padding-bottom: var(--space-section);
    row-gap: var(--space-4);
  }

  .stage {
    background: var(--paper-2);
    cursor: crosshair;
  }
</style>

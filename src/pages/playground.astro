---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import RegistrationField from '../components/RegistrationField.astro';
---

<Base title="Playground" description="Experiments, side projects and things Valerio Rosponi made for the joy of it.">
  <header class="wrap grid intro">
    <h1 class="display col-wide">Things made for the joy of it.</h1>
    <p class="lead col-text intro__lead">
      No briefs, no stakeholders, no deadlines. Just curiosity, and the occasional bug that turns out to be a feature.
    </p>
  </header>

  <div class="wrap">
    <Section title="Experiments" id="experiments" stacked>
      <article class="exp trio">
        <div class="exp__stage span-2" data-reveal="clip">
          <RegistrationField spacing={26} radius={200} />
          <span class="exp__hint label">Move your cursor</span>
        </div>
        <div class="exp__info">
          <h3 class="h3 trim">Registration field</h3>
          <p>
            The cursor-reactive grid that opened the first version of this site, given room to breathe. Print registration marks that turn and
            warm up as you pass, a small nod to the precision behind every layout.
          </p>
          <p class="label muted">Canvas · TypeScript · 2026</p>
        </div>
      </article>
    </Section>
  </div>
</Base>

<style>
  .intro {
    padding-top: calc(var(--header-h) + var(--space-6) * 2);
    row-gap: var(--space-4);
  }

  .exp__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--paper-2);
    overflow: hidden;
    cursor: crosshair;
  }

  .exp__hint {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    color: var(--ink-3);
    pointer-events: none;
  }

  .exp__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--ink-2);
  }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import portrait from '../assets/valerio-rosponi.png';
import { site } from '../data/site';

const strengths = [
  {
    title: 'Visual & UI design',
    text: 'Typography, layout, colour and the small decisions that make an interface feel considered.',
  },
  {
    title: 'Information architecture',
    text: 'Turning messy content and features into structures people can navigate without thinking.',
  },
  {
    title: 'Interaction design',
    text: 'Flows, states and feedback that make every step feel obvious and every action reversible.',
  },
  {
    title: 'Design systems',
    text: 'Components, variables and tokens that keep a product consistent as it grows.',
  },
  {
    title: 'Working with developers',
    text: 'I understand how interfaces get built, so my specs are realistic and my handoffs are clear.',
  },
  {
    title: 'Prototyping & motion',
    text: 'High-fidelity prototypes and motion that test ideas before they become expensive.',
  },
];

const toolkit = [
  { name: 'Figma', use: 'Interface design, prototyping, variables and design systems.' },
  { name: 'Stitch & AI tools', use: 'Rapid exploration and generating directions to react to.' },
  { name: 'Unity', use: 'Interactive, spatial and XR prototypes.' },
  { name: 'IDEs', use: 'Building and testing what I design, in code.' },
];

const now = [
  { label: 'Studying', text: 'BSc in Interfaces & Communication, University of Trento.' },
  { label: 'Based in', text: 'Trentino, Italy. Open to remote work.' },
  {
    label: 'Looking for',
    text: 'Junior roles in UX, digital product and visual design. Especially drawn to health, fintech, fashion and wellbeing.',
  },
];
---

<Base
  title="About"
  description="About Valerio Rosponi — how he thinks about design, what he brings to a team and what he is looking for."
  showFooterContact={false}
>
  <header class="wrap grid intro">
    <h1 class="display col-wide">Useful to as many people as possible, and beautiful enough to make them stay.</h1>
  </header>

  <div class="wrap">
    <Section title="Approach" id="approach">
      <div class="trio">
        <figure class="portrait" data-reveal="clip">
          <Image
            src={portrait}
            alt="Portrait of Valerio Rosponi"
            widths={[400, 640, 900, 1200]}
            sizes="(min-width: 960px) 24vw, 100vw"
            class="portrait__img"
          />
        </figure>

        <div class="approach span-2">
          <p class="lead trim" data-reveal>
            For me, design is the point where usefulness and beauty stop being separate goals. A product should solve a
            real problem for as many people as possible, and it should be crafted well enough that people trust it at
            first sight.
          </p>
          <p data-reveal>
            I start from evidence: who the people are, what gets in their way, and what the data says about it. From
            there I work on structure before style, because a product that makes sense is already halfway to being a
            product people enjoy.
          </p>
          <p data-reveal>
            Then I obsess over the details, and I try to push a little further than the expected. New ways of
            interacting, new visual languages: I like to explore them, and then test whether they really work for the
            people they are meant for.
          </p>
        </div>
      </div>
    </Section>

    <Section title="What I bring" id="strengths" tone="alt">
      <ol>
        {
          strengths.map((s, i) => (
            <li class="row trio">
              <div class="row__head" data-reveal>
                <span class="label row__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="h3 trim">{s.title}</h3>
              </div>
              <p class="row__text span-2 trim" data-reveal style="--d:1">
                {s.text}
              </p>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section title="Toolkit" id="toolkit">
      <ul>
        {
          toolkit.map((t) => (
            <li class="row trio">
              <h3 class="h3 trim" data-reveal>
                {t.name}
              </h3>
              <p class="row__text span-2 trim" data-reveal style="--d:1">
                {t.use}
              </p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section title="Now" id="now">
      <dl class="trio">
        {
          now.map((n, i) => (
            <div class="item" data-reveal style={`--d:${i}`}>
              <dt class="label muted">{n.label}</dt>
              <dd>{n.text}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section title="Contact" id="contact">
      <ul class="trio">
        <li class="item" data-reveal>
          <span class="label muted">Email</span>
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li class="item" data-reveal style="--d:1">
          <span class="label muted">LinkedIn</span>
          <a href={site.linkedin} target="_blank" rel="noopener">
            Valerio Rosponi <span class="arrow arrow--ne" aria-hidden="true">↗</span>
          </a>
        </li>
        <li class="item" data-reveal style="--d:2">
          <span class="label muted">Résumé</span>
          <a href={site.cv} target="_blank" rel="noopener">
            Download PDF <span class="arrow arrow--ne" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </Section>
  </div>
</Base>

<style>
  .intro {
    padding-top: calc(var(--header-h) + var(--space-6) * 2);
  }

  /* Approach */
  .portrait {
    align-self: start;
    background: var(--paper);
  }

  .portrait__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: multiply;
    transition: filter 0.8s var(--ease-out);
  }

  .portrait:hover .portrait__img {
    filter: grayscale(0) contrast(1);
  }

  .approach {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--ink-2);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .approach > * {
    max-width: 60ch;
  }

  /* Rows (strengths, toolkit) */
  .row {
    row-gap: var(--space-2);
    padding-block: var(--space-3) var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .row__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .row__n {
    color: var(--signal);
    text-box: trim-both cap alphabetic;
  }

  .row__text {
    max-width: 58ch;
    color: var(--ink-2);
  }

  /* Now + contact items */
  .item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .item > :first-child {
    text-box: trim-start cap alphabetic;
  }

  .item dd {
    max-width: 32ch;
  }
</style>

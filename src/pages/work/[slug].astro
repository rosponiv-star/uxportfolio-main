---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Cover from '../../components/Cover.astro';
import Chapter from '../../components/case/Chapter.astro';
import Todo from '../../components/case/Todo.astro';
import Figure from '../../components/case/Figure.astro';
import Note from '../../components/case/Note.astro';
import Metrics from '../../components/case/Metrics.astro';
import Insights from '../../components/case/Insights.astro';
import { chaptersOf, getProjects, hrefOf, slugOf, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, tagline, role, timeline, team, type, platform, tools, glance } = project.data;
const { Content } = await render(project);
const chapters = chaptersOf(project);
const contentsRows = Math.ceil(chapters.length / 3);

const glanceItems = [
  { label: 'Problem', text: glance.problem },
  { label: 'Approach', text: glance.approach },
  { label: 'Outcome', text: glance.outcome },
];

const facts = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  { label: 'Team', value: team },
  { label: 'Type', value: type },
  { label: 'Platform', value: platform },
  { label: 'Tools', value: tools.join(', ') },
];
---

<Base title={title} description={`${title} — ${tagline}`}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article data-progress-target>
    <!-- Intro ------------------------------------------------------------ -->
    <header class="wrap intro">
      <a href="/#work" class="intro__back label">
        <span class="arrow arrow--back" aria-hidden="true">←</span> All work
      </a>
      <h1 class="intro__title trim">{title}</h1>
      <div class="grid">
        <p class="intro__tagline lead col-text" data-reveal>{tagline}</p>
      </div>
    </header>

    <div class="wrap intro__cover" data-reveal="clip">
      <Cover project={project} eager sizes="100vw" />
    </div>

    <div class="wrap">
      <!-- Overview: the 30-second read ----------------------------------- -->
      <Section title="Overview" id="overview" bodyClass="flow" tone="alt">
        <div class="trio">
          {
            glanceItems.map((g, i) => (
              <div class="glance" data-reveal style={`--d:${i}`}>
                <p class="label muted">{g.label}</p>
                <p class="glance__text">{g.text}</p>
              </div>
            ))
          }
        </div>

        <dl class="trio facts-grid">
          {
            facts.map((f) => (
              <div>
                <dt class="label muted">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <!-- Contents ------------------------------------------------------- -->
      <Section title="Contents" id="contents">
        <ol class="contents" style={`--rows:${contentsRows}`}>
          {
            chapters.map((c, i) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="label">{String(i + 1).padStart(2, '0')}</span>
                  <span>{c.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </Section>

      <!-- Chapters (from MDX) ---------------------------------------------- -->
      <div class="chapters">
        <Content components={{ Chapter, Todo, Figure, Note, Metrics, Insights }} />
      </div>

      <!-- Next ----------------------------------------------------------- -->
      <Section title="Next" id="next">
        <a href={hrefOf(next)} class="next trio" data-cursor="Next case study">
          <span class="next__main span-2">
            <span class="next__title trim">{next.data.title}</span>
            <span class="next__tagline">{next.data.tagline}</span>
            <span class="next__cta label">Read case study <span class="arrow" aria-hidden="true">→</span></span>
          </span>
          <span class="next__thumb">
            <Cover project={next} sizes="(min-width: 960px) 24vw, 100vw" />
          </span>
        </a>
      </Section>
    </div>
  </article>
</Base>

<style>
  /* Progress ------------------------------------------------------------- */
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 2px;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Intro ---------------------------------------------------------------- */
  .intro {
    padding-top: calc(var(--header-h) + var(--space-6));
  }

  .intro__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--ink-3);
    transition: color 0.25s;
  }

  .intro__back:hover {
    color: var(--ink);
  }

  .intro__title {
    margin-top: var(--space-5);
    margin-left: -0.05em;
    font-size: var(--fs-mega);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .intro__tagline {
    margin-top: var(--space-5);
  }

  .intro__cover {
    margin-top: var(--space-6);
  }

  /* Overview ------------------------------------------------------------- */
  .glance {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .glance .label {
    text-box: trim-start cap alphabetic;
  }

  .glance__text {
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }

  .facts-grid {
    row-gap: var(--space-3);
  }

  .facts-grid dt {
    margin-bottom: 4px;
  }

  /* Contents ------------------------------------------------------------- */
  .contents {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    grid-auto-flow: column;
    column-gap: var(--gutter);
  }

  .contents a {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: 6px;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .contents a:hover {
    color: var(--ink);
  }

  .contents .label {
    color: var(--signal);
    min-width: 2ch;
  }

  @media (max-width: 640px) {
    .contents {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }

  /* Chapters ------------------------------------------------------------- */
  .chapters {
    counter-reset: chapter;
  }

  .chapters :global(.chapter) {
    counter-increment: chapter;
  }

  .chapters :global(.chapter__n) {
    color: var(--signal);
    text-box: trim-both cap alphabetic;
  }

  .chapters :global(.chapter__n)::before {
    content: counter(chapter, decimal-leading-zero);
  }

  /* Next ----------------------------------------------------------------- */
  .next {
    align-items: start;
  }

  .next__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .next__title {
    font-size: clamp(3rem, 1rem + 6vw, 7.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.055em;
    transition: color 0.3s;
  }

  .next__tagline {
    max-width: 46ch;
    color: var(--ink-2);
  }

  .next__cta {
    color: var(--ink-3);
    transition: color 0.25s;
  }

  .next__thumb {
    display: block;
    overflow: hidden;
  }

  .next:hover .next__title {
    color: var(--ink-3);
  }

  .next:hover .next__cta {
    color: var(--ink);
  }
</style>

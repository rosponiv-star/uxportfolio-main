---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Cover from '../../components/Cover.astro';
import { Image } from 'astro:assets';
import Chapter from '../../components/case/Chapter.astro';
import Todo from '../../components/case/Todo.astro';
import Key from '../../components/case/Key.astro';
import Chips from '../../components/case/Chips.astro';
import BigStat from '../../components/case/BigStat.astro';
import Features from '../../components/case/Features.astro';
import Gallery from '../../components/case/Gallery.astro';
import Closing from '../../components/case/Closing.astro';
import BoxStrip from '../../components/case/BoxStrip.astro';
import ProcessIndex from '../../components/case/ProcessIndex.astro';
import Showcase from '../../components/case/Showcase.astro';
import Figure from '../../components/case/Figure.astro';
import Note from '../../components/case/Note.astro';
import Metrics from '../../components/case/Metrics.astro';
import Insights from '../../components/case/Insights.astro';
import Reframes from '../../components/case/Reframes.astro';
import Archetypes from '../../components/case/Archetypes.astro';
import Reference from '../../components/case/Reference.astro';
import SystemMap from '../../components/case/SystemMap.astro';
import Spot from '../../components/case/Spot.astro';
import { chaptersOf, getProjects, hrefOf, slugOf, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  // The next band only points to finished case studies: placeholders are built but never linked.
  const nextOf = (i: number) =>
    projects
      .slice(i + 1)
      .concat(projects.slice(0, i))
      .find((p) => !p.data.placeholder);
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: { project, next: nextOf(i) },
  }));
}

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const { title, tagline, role, timeline, team, type, platform, tools, glance, result } = project.data;
const { Content } = await render(project);
const chapters = chaptersOf(project);
const nextCover = next?.data.cover;
const nextHasMedia = Boolean(nextCover?.image || nextCover?.video);

const glanceItems = [
  { label: 'Problem', text: glance.problem },
  { label: 'Approach', text: glance.approach },
  { label: 'Outcome', text: glance.outcome },
];

const facts = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  { label: 'Team', value: team },
  { label: 'Type', value: type },
  { label: 'Platform', value: platform },
  { label: 'Tools', value: tools.join(', ') },
];
---

<Base title={title} description={`${title} — ${tagline}`} noindex={project.data.placeholder} image={project.data.cover?.image}>
  <article>
    <!-- Intro ------------------------------------------------------------ -->
    <header class="wrap intro">
      <a href="/#work" class="intro__back">
        <span class="intro__arrow" aria-hidden="true"></span>
        <span class="label">All work</span>
      </a>
      <h1 class="intro__title trim">{title}</h1>
      <div class="grid">
        <p class="intro__tagline lead col-text" data-reveal>{tagline}</p>
      </div>
    </header>

    <div class="wrap intro__cover" data-reveal="clip">
      <Cover project={project} eager sizes="100vw" />
    </div>

    <div class="wrap">
      <!-- Overview: the 30-second read ----------------------------------- -->
      <Section title="Overview" id="overview" class="overview">
        <!-- One cell grid: the three sentences on top, the facts below. -->
        <dl class="cells sheet">
          {
            glanceItems.map((g, i) => (
              <div class="cell glance" data-reveal style={`--d:${i}`}>
                <dt class="label label--group">{g.label}</dt>
                <dd class="glance__text cell__foot">{g.text}</dd>
              </div>
            ))
          }
          {
            facts.map((f) => (
              <div class="cell fact">
                <dt class="label muted">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <!-- Result: what was made and what it achieves, before the process ---- -->
      {
        result && (
          <Section
            title="Result"
            id="result"
            bodyClass="flow"
            tone="alt"
            stacked={Boolean(result.showcase)}
            class={result.showcase ? 'result--showcase' : undefined}
          >
            {result.showcase ? (
              <>
                <p class="result__text">{result.text}</p>
                <div class="result__showcase">
                  <Showcase groups={result.showcase} />
                </div>
              </>
            ) : result.media.length > 0 && (
              <div class="trio result__media">
                {result.media.map((m) =>
                  m.kind === 'wide' ? (
                    <div class="result__wide">
                      <Figure src={m.image} alt={m.alt} ratio="16/9" placeholder={m.label} />
                    </div>
                  ) : (
                    <Figure src={m.image} alt={m.alt} ratio="9/19.5" placeholder={m.label} />
                  ),
                )}
              </div>
            )}
            {!result.showcase && <p class="result__text">{result.text}</p>}
            {result.metrics.length > 0 && (
              <div class="result__metrics">
                {result.metricsLabel && <p class="label label--group result__metrics-label">{result.metricsLabel}</p>}
                <Metrics items={result.metrics} />
              </div>
            )}
          </Section>
        )
      }

      <!-- Process: the chapters below ----------------------------------- -->
      <Section title="Process" id="contents">
        <ProcessIndex chapters={chapters} />
      </Section>

      <!-- Chapters (from MDX) ---------------------------------------------- -->
      <div class="chapters">
        <Content components={{ Chapter, Key, Chips, BigStat, Features, Gallery, Closing, BoxStrip, Todo, Figure, Note, Metrics, Insights, Reframes, Archetypes, Reference, SystemMap, Spot }} />
      </div>

    </div>
  </article>

  <ProcessIndex chapters={chapters} bar />

  <!-- Next case study: full-bleed band in the next finished project's tone -- -->
  {next && (
  <a
    href={hrefOf(next)}
    class:list={['next', { 'next--dark': next.data.toneDark || nextHasMedia, 'next--media': nextHasMedia }]}
    style={`--tone: ${next.data.tone}`}
    data-cursor="Open case study"
    data-cursor-theme={next.data.toneDark || nextHasMedia ? 'light' : undefined}
    aria-label={`Next case study: ${next.data.title}`}
  >
    <!-- Background: the next project's cover (image/video), or its placeholder cover pattern -->
    <div class="next__bg" aria-hidden="true">
      {
        nextCover?.video ? (
          <video src={nextCover.video} poster={nextCover.image?.src} muted loop playsinline preload="metadata" data-autoplay />
        ) : nextCover?.image ? (
          <Image src={nextCover.image} alt="" widths={[960, 1600, 2400]} sizes="100vw" />
        ) : (
          <span class="next__grid" />
        )
      }
    </div>
    <div class="wrap grid next__inner">
      <p class="next__label label">Next case study</p>
      <p class="next__title">{next.data.title}</p>
      <p class="next__tagline">{next.data.tagline}</p>
    </div>
  </a>
  )}
</Base>

<style>
  /* Intro ---------------------------------------------------------------- */
  .intro {
    padding-top: calc(var(--header-h) + var(--space-6));
  }

  /* Back link, editorial: a drawn hairline arrow and a label; the line stretches on hover. */
  .intro__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-1);
    color: var(--ink-2);
    transition: color 0.3s;
  }

  .intro__arrow {
    position: relative;
    width: 20px;
    height: 1px;
    background: currentColor;
    transition: width 0.6s var(--ease-out);
  }

  .intro__arrow::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 5px;
    height: 5px;
    border-left: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translate(0, -50%) rotate(45deg);
  }

  .intro__back:hover,
  .intro__back:focus-visible {
    color: var(--ink);
  }

  .intro__back:hover .intro__arrow,
  .intro__back:focus-visible .intro__arrow {
    width: 32px;
  }


  .intro__title {
    margin-top: var(--space-5);
    margin-left: -0.05em;
    font-size: var(--fs-mega);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .intro__tagline {
    margin-top: var(--space-5);
  }

  .intro__cover {
    margin-top: var(--space-6);
  }

  /* Overview ------------------------------------------------------------- */
  .sheet dd {
    margin: 0;
  }

  .glance {
    grid-column: span 2;
    min-height: 240px;
  }

  .glance__text {
    padding-top: var(--space-4);
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }

  .fact {
    grid-column: span 2;
    gap: var(--space-1);
  }

  /* No rule above the Overview: its cell grid already frames it (owner, 2026-10-20). */
  :global(.overview)::before {
    display: none;
  }

  /* Phones: the three sentences full width, the facts two per row. */
  @media (max-width: 640px) {
    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .glance {
      grid-column: 1 / -1 !important;
      min-height: 0;
    }
  }

  /* Result --------------------------------------------------------------- */
  .result__media {
    row-gap: var(--gutter);
  }

  .result__wide {
    grid-column: 1 / -1;
  }

  .result__text {
    max-width: calc((200% - var(--gutter)) / 3);
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  /* With a showcase the body takes all 12 columns: text and numbers keep the body lane,
     the interface groups use the whole grid. */
  :global(.result--showcase > .sec__body) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  :global(.result--showcase > .sec__body) > * {
    grid-column: 4 / -1;
  }

  :global(.result--showcase > .sec__body) > .result__showcase {
    grid-column: 1 / -1;
    margin-top: var(--space-section);
  }

  :global(.result--showcase > .sec__body) > .result__metrics {
    margin-top: var(--space-section);
  }

  @media (max-width: 960px) {
    :global(.result--showcase > .sec__body) > * {
      grid-column: 1 / -1;
    }
  }

  .result__metrics-label {
    margin-bottom: var(--space-3);
  }

  /* Phones: screens become a swipeable row (wide boards stay full width, after it). */
  @media (max-width: 640px) {
    .result__text {
      max-width: none;
    }

    .result__media {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 62%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--margin) * -1);
      padding-inline: var(--margin);
      scroll-padding-inline: var(--margin);
    }

    .result__media > :global(*) {
      scroll-snap-align: start;
    }

    .result__wide {
      grid-column: auto;
      grid-auto-columns: 100%;
      width: calc(100vw - 2 * var(--margin));
    }
  }

  /* Chapters ------------------------------------------------------------- */
  .chapters {
    counter-reset: chapter;
  }

  .chapters :global(.chapter) {
    counter-increment: chapter;
  }

  .chapters :global(.chapter__n) {
    color: var(--signal);
    text-box: trim-both cap alphabetic;
  }

  .chapters :global(.chapter__n)::before {
    content: counter(chapter, decimal-leading-zero);
  }

  /* Next case study band ---------------------------------------------- */
  .next {
    position: relative;
    display: block;
    margin-top: var(--space-section);
    background: var(--tone);
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  .next--dark {
    color: var(--paper);
  }

  /* Background layer: real cover media (with a flat scrim for legibility) or the
     placeholder cover pattern. Scales slightly on hover. */
  .next__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform 1.4s var(--ease-out);
  }

  .next:hover .next__bg {
    transform: scale(1.03);
  }

  .next__bg :global(img),
  .next__bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .next--media .next__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(17 17 17 / 0.72);
  }

  .next__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center;
    mask-image: radial-gradient(ellipse at 60% 40%, #000 25%, transparent 85%);
  }

  /* One block anchored bottom-left: label → title → tagline. */
  .next__inner {
    position: relative;
    min-height: clamp(440px, 76vh, 800px);
    align-content: end;
    padding-block: var(--space-6);
    pointer-events: none;
  }

  .next__label {
    grid-column: 1 / -1;
  }

  .next__title {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    margin-left: -0.05em;
    font-size: var(--fs-mega);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.06em;
    text-wrap: balance;
    transition: transform 0.9s var(--ease-out);
  }

  .next:hover .next__title {
    transform: translateX(var(--space-3));
  }

  .next__tagline {
    grid-column: 1 / span 6;
    margin-top: var(--space-4);
    max-width: 40ch;
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.012em;
    opacity: 0.8;
  }

  /* The band already separates the page from the footer */
  :global(main:has(.next) + .footer .footer__contact)::before {
    display: none;
  }

  :global(main:has(.next) + .footer .footer__contact) {
    padding-top: 0;
  }

  @media (max-width: 960px) {
    .next__tagline {
      grid-column: 1 / -1;
    }
  }
</style>

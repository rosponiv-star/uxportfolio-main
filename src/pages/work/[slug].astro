---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Cover from '../../components/Cover.astro';
import PhoneScroll from '../../components/PhoneScroll.astro';
import { Image } from 'astro:assets';
import Chapter from '../../components/case/Chapter.astro';
import Todo from '../../components/case/Todo.astro';
import Figure from '../../components/case/Figure.astro';
import Note from '../../components/case/Note.astro';
import Metrics from '../../components/case/Metrics.astro';
import Insights from '../../components/case/Insights.astro';
import Reframes from '../../components/case/Reframes.astro';
import Archetypes from '../../components/case/Archetypes.astro';
import { chaptersOf, getProjects, hrefOf, slugOf, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, tagline, role, timeline, team, type, platform, tools, glance } = project.data;
const { Content } = await render(project);
const chapters = chaptersOf(project);
const contentsRows = Math.ceil(chapters.length / 3);
const nextCover = next.data.cover;
const nextHasMedia = Boolean(nextCover?.image || nextCover?.video);

const glanceItems = [
  { label: 'Problem', text: glance.problem },
  { label: 'Approach', text: glance.approach },
  { label: 'Outcome', text: glance.outcome },
];

const facts = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  { label: 'Team', value: team },
  { label: 'Type', value: type },
  { label: 'Platform', value: platform },
  { label: 'Tools', value: tools.join(', ') },
];
---

<Base title={title} description={`${title} — ${tagline}`}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article data-progress-target>
    <!-- Intro ------------------------------------------------------------ -->
    <header class="wrap intro">
      <a href="/#work" class="intro__back">
        <span class="arrow arrow--back" aria-hidden="true">←</span>
        <span>All work</span>
      </a>
      <h1 class="intro__title trim">{title}</h1>
      <div class="grid">
        <p class="intro__tagline lead col-text" data-reveal>{tagline}</p>
      </div>
    </header>

    <div class="wrap intro__cover" data-reveal="clip">
      <Cover project={project} eager sizes="100vw" />
    </div>

    <div class="wrap">
      <!-- Overview: the 30-second read ----------------------------------- -->
      <Section title="Overview" id="overview" bodyClass="flow" tone="alt">
        <div class="trio">
          {
            glanceItems.map((g, i) => (
              <div class="glance" data-reveal style={`--d:${i}`}>
                <p class="label muted">{g.label}</p>
                <p class="glance__text">{g.text}</p>
              </div>
            ))
          }
        </div>

        <dl class="trio facts-grid">
          {
            facts.map((f) => (
              <div>
                <dt class="label muted">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <!-- Device walkthrough: placeholder screens until the real interfaces arrive -->
      <PhoneScroll
        label={`${title} interface walkthrough`}
        screens={[
          { color: project.data.tone },
          { color: '#e9e6df' },
          { color: '#3d5a73' },
          { color: '#cfd6d1' },
          { color: '#1c1c1a' },
        ]}
      />

      <!-- Contents ------------------------------------------------------- -->
      <Section title="Contents" id="contents">
        <ol class="contents" style={`--rows:${contentsRows}`}>
          {
            chapters.map((c, i) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="label">{String(i + 1).padStart(2, '0')}</span>
                  <span>{c.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </Section>

      <!-- Chapters (from MDX) ---------------------------------------------- -->
      <div class="chapters">
        <Content components={{ Chapter, Todo, Figure, Note, Metrics, Insights, Reframes, Archetypes }} />
      </div>

    </div>
  </article>

  <!-- Next case study: full-bleed band in the next project's tone ---------- -->
  <a
    href={hrefOf(next)}
    class:list={['next', { 'next--dark': next.data.toneDark || nextHasMedia, 'next--media': nextHasMedia }]}
    style={`--tone: ${next.data.tone}`}
    data-cursor="Open case study"
    data-cursor-theme={next.data.toneDark || nextHasMedia ? 'light' : undefined}
    aria-label={`Next case study: ${next.data.title}`}
  >
    <!-- Background: the next project's cover (image/video), or its placeholder cover pattern -->
    <div class="next__bg" aria-hidden="true">
      {
        nextCover?.video ? (
          <video src={nextCover.video} poster={nextCover.image?.src} muted loop playsinline preload="metadata" data-autoplay />
        ) : nextCover?.image ? (
          <Image src={nextCover.image} alt="" widths={[960, 1600, 2400]} sizes="100vw" />
        ) : (
          <span class="next__grid" />
        )
      }
    </div>
    <span class="reg next__reg next__reg--tl" aria-hidden="true"></span>
    <span class="reg next__reg next__reg--tr" aria-hidden="true"></span>
    <span class="reg next__reg next__reg--bl" aria-hidden="true"></span>
    <span class="reg next__reg next__reg--br" aria-hidden="true"></span>
    <div class="wrap grid next__inner">
      <p class="next__label label">Next case study</p>
      <p class="next__title">{next.data.title}</p>
      <p class="next__tagline">{next.data.tagline}</p>
    </div>
  </a>
</Base>

<style>
  /* Progress ------------------------------------------------------------- */
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 2px;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Intro ---------------------------------------------------------------- */
  .intro {
    padding-top: calc(var(--header-h) + var(--space-6));
  }

  /* Quiet outlined button: clearly clickable, never louder than the title */
  .intro__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 40px;
    padding: 0 18px 0 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    background: transparent;
    transition:
      color 0.25s,
      border-color 0.25s,
      background-color 0.25s;
  }

  .intro__back:hover,
  .intro__back:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--paper-2);
  }

  .intro__title {
    margin-top: var(--space-5);
    margin-left: -0.05em;
    font-size: var(--fs-mega);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .intro__tagline {
    margin-top: var(--space-5);
  }

  .intro__cover {
    margin-top: var(--space-6);
  }

  /* Overview ------------------------------------------------------------- */
  .glance {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .glance .label {
    text-box: trim-start cap alphabetic;
  }

  .glance__text {
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }

  .facts-grid {
    row-gap: var(--space-3);
  }

  .facts-grid dt {
    margin-bottom: 4px;
  }

  /* Contents ------------------------------------------------------------- */
  .contents {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    grid-auto-flow: column;
    column-gap: var(--gutter);
  }

  .contents a {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: 6px;
    font-size: var(--fs-small);
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .contents a:hover {
    color: var(--ink);
  }

  .contents .label {
    color: var(--signal);
    min-width: 2ch;
  }

  @media (max-width: 640px) {
    .contents {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }

  /* Chapters ------------------------------------------------------------- */
  .chapters {
    counter-reset: chapter;
  }

  .chapters :global(.chapter) {
    counter-increment: chapter;
  }

  .chapters :global(.chapter__n) {
    color: var(--signal);
    text-box: trim-both cap alphabetic;
  }

  .chapters :global(.chapter__n)::before {
    content: counter(chapter, decimal-leading-zero);
  }

  /* Next case study band ---------------------------------------------- */
  .next {
    position: relative;
    display: block;
    margin-top: var(--space-section);
    background: var(--tone);
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  .next--dark {
    color: var(--paper);
  }

  /* Background layer: real cover media (with a flat scrim for legibility) or the
     placeholder cover pattern. Scales slightly on hover. */
  .next__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform 1.4s var(--ease-out);
  }

  .next:hover .next__bg {
    transform: scale(1.03);
  }

  .next__bg :global(img),
  .next__bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .next--media .next__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(17 17 17 / 0.72);
  }

  .next__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center;
    mask-image: radial-gradient(ellipse at 60% 40%, #000 25%, transparent 85%);
  }

  .next__reg {
    position: absolute;
    width: 13px;
    height: 13px;
    opacity: 0.6;
  }

  .next__reg--tl {
    top: var(--space-3);
    left: var(--space-3);
  }

  .next__reg--tr {
    top: var(--space-3);
    right: var(--space-3);
  }

  .next__reg--bl {
    bottom: var(--space-3);
    left: var(--space-3);
  }

  .next__reg--br {
    bottom: var(--space-3);
    right: var(--space-3);
  }

  /* One block anchored bottom-left: label → title → tagline. */
  .next__inner {
    position: relative;
    min-height: clamp(440px, 76vh, 800px);
    align-content: end;
    padding-block: var(--space-6);
    pointer-events: none;
  }

  .next__label {
    grid-column: 1 / -1;
  }

  .next__title {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    margin-left: -0.05em;
    font-size: var(--fs-mega);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.06em;
    text-wrap: balance;
    transition: transform 0.9s var(--ease-out);
  }

  .next:hover .next__title {
    transform: translateX(var(--space-3));
  }

  .next__tagline {
    grid-column: 1 / span 6;
    margin-top: var(--space-4);
    max-width: 40ch;
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.012em;
    opacity: 0.8;
  }

  /* The band already separates the page from the footer */
  :global(main:has(.next) + .footer .footer__contact)::before {
    display: none;
  }

  :global(main:has(.next) + .footer .footer__contact) {
    padding-top: 0;
  }

  @media (max-width: 960px) {
    .next__tagline {
      grid-column: 1 / -1;
    }
  }
</style>

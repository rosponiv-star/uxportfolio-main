---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Cover from '../../components/Cover.astro';
import { Image } from 'astro:assets';
import Chapter from '../../components/case/Chapter.astro';
import Todo from '../../components/case/Todo.astro';
import Key from '../../components/case/Key.astro';
import ProcessIndex from '../../components/case/ProcessIndex.astro';
import Figure from '../../components/case/Figure.astro';
import Note from '../../components/case/Note.astro';
import Metrics from '../../components/case/Metrics.astro';
import Insights from '../../components/case/Insights.astro';
import Reframes from '../../components/case/Reframes.astro';
import Archetypes from '../../components/case/Archetypes.astro';
import { chaptersOf, getProjects, hrefOf, slugOf, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, tagline, role, timeline, team, type, platform, tools, glance, result } = project.data;
const { Content } = await render(project);
const chapters = chaptersOf(project);
const nextCover = next.data.cover;
const nextHasMedia = Boolean(nextCover?.image || nextCover?.video);

const glanceItems = [
  { label: 'Problem', text: glance.problem },
  { label: 'Approach', text: glance.approach },
  { label: 'Outcome', text: glance.outcome },
];

const facts = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  { label: 'Team', value: team },
  { label: 'Type', value: type },
  { label: 'Platform', value: platform },
  { label: 'Tools', value: tools.join(', ') },
];
---

<Base title={title} description={`${title} — ${tagline}`}>
  <article>
    <!-- Intro ------------------------------------------------------------ -->
    <header class="wrap intro">
      <a href="/#work" class="intro__back">
        <svg class="intro__chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>All work</span>
      </a>
      <h1 class="intro__title trim">{title}</h1>
      <div class="grid">
        <p class="intro__tagline lead col-text" data-reveal>{tagline}</p>
      </div>
    </header>

    <div class="wrap intro__cover" data-reveal="clip">
      <Cover project={project} eager sizes="100vw" />
    </div>

    <div class="wrap">
      <!-- Overview: the 30-second read ----------------------------------- -->
      <Section title="Overview" id="overview" class="overview">
        <div class="sheet">
        <div class="trio sheet__glance">
          {
            glanceItems.map((g, i) => (
              <div class="glance" data-reveal style={`--d:${i}`}>
                <p class="label muted">{g.label}</p>
                <p class="glance__text">{g.text}</p>
              </div>
            ))
          }
        </div>

        <dl class="trio sheet__facts">
          {
            facts.map((f) => (
              <div>
                <dt class="label muted">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        </div>
      </Section>

      <!-- Result: what was made and what it achieves, before the process ---- -->
      {
        result && (
          <Section title="Result" id="result" bodyClass="flow" tone="alt">
            {result.media.length > 0 && (
              <div class="trio result__media">
                {result.media.map((m) =>
                  m.kind === 'wide' ? (
                    <div class="result__wide">
                      <Figure src={m.image} alt={m.alt} ratio="16/9" placeholder={m.label} />
                    </div>
                  ) : (
                    <Figure src={m.image} alt={m.alt} ratio="9/19.5" placeholder={m.label} />
                  ),
                )}
              </div>
            )}
            <p class="result__text">{result.text}</p>
            {result.metrics.length > 0 && (
              <div class="result__metrics">
                {result.metricsLabel && <p class="label muted result__metrics-label">{result.metricsLabel}</p>}
                <Metrics items={result.metrics} />
              </div>
            )}
          </Section>
        )
      }

      <!-- Process: the chapters below ----------------------------------- -->
      <Section title="Process" id="contents">
        <ProcessIndex chapters={chapters} />
      </Section>

      <!-- Chapters (from MDX) ---------------------------------------------- -->
      <div class="chapters">
        <Content components={{ Chapter, Key, Todo, Figure, Note, Metrics, Insights, Reframes, Archetypes }} />
      </div>

    </div>
  </article>

  <ProcessIndex chapters={chapters} bar />

  <!-- Next case study: full-bleed band in the next project's tone ---------- -->
  <a
    href={hrefOf(next)}
    class:list={['next', { 'next--dark': next.data.toneDark || nextHasMedia, 'next--media': nextHasMedia }]}
    style={`--tone: ${next.data.tone}`}
    data-cursor="Open case study"
    data-cursor-theme={next.data.toneDark || nextHasMedia ? 'light' : undefined}
    aria-label={`Next case study: ${next.data.title}`}
  >
    <!-- Background: the next project's cover (image/video), or its placeholder cover pattern -->
    <div class="next__bg" aria-hidden="true">
      {
        nextCover?.video ? (
          <video src={nextCover.video} poster={nextCover.image?.src} muted loop playsinline preload="metadata" data-autoplay />
        ) : nextCover?.image ? (
          <Image src={nextCover.image} alt="" widths={[960, 1600, 2400]} sizes="100vw" />
        ) : (
          <span class="next__grid" />
        )
      }
    </div>
    <div class="wrap grid next__inner">
      <p class="next__label label">Next case study</p>
      <p class="next__title">{next.data.title}</p>
      <p class="next__tagline">{next.data.tagline}</p>
    </div>
  </a>
</Base>

<style>
  /* Intro ---------------------------------------------------------------- */
  .intro {
    padding-top: calc(var(--header-h) + var(--space-6));
  }

  /* Quiet outlined button: clearly clickable, never louder than the title */
  .intro__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 40px;
    padding: 0 18px 0 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    background: transparent;
    transition:
      color 0.25s,
      border-color 0.25s,
      background-color 0.25s;
  }

  .intro__chev {
    flex: none;
  }

  .intro__back:hover,
  .intro__back:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--paper-2);
  }

  .intro__title {
    margin-top: var(--space-5);
    margin-left: -0.05em;
    font-size: var(--fs-mega);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .intro__tagline {
    margin-top: var(--space-5);
  }

  .intro__cover {
    margin-top: var(--space-6);
  }

  /* Overview ------------------------------------------------------------- */
  .glance {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .glance .label {
    text-box: trim-start cap alphabetic;
  }

  .glance__text {
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }

  /* Set apart by an ink rule instead of the usual grey one; inside, only space separates
     the three sentences from the facts. */
  :global(.overview)::before {
    background: var(--ink);
  }

  .sheet__facts {
    margin-top: var(--space-6);
    row-gap: var(--space-3);
  }

  .sheet__facts dt {
    margin-bottom: 4px;
  }

  @media (max-width: 640px) {
    .sheet__glance {
      row-gap: var(--space-4);
    }

    .sheet__facts {
      margin-top: var(--space-5);
    }
  }

  /* Result --------------------------------------------------------------- */
  .result__media {
    row-gap: var(--gutter);
  }

  .result__wide {
    grid-column: 1 / -1;
  }

  .result__text {
    max-width: calc((200% - var(--gutter)) / 3);
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .result__metrics-label {
    margin-bottom: var(--space-3);
  }

  /* Phones: screens become a swipeable row (wide boards stay full width, after it). */
  @media (max-width: 640px) {
    .result__text {
      max-width: none;
    }

    .result__media {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 62%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--margin) * -1);
      padding-inline: var(--margin);
      scroll-padding-inline: var(--margin);
    }

    .result__media > :global(*) {
      scroll-snap-align: start;
    }

    .result__wide {
      grid-column: auto;
      grid-auto-columns: 100%;
      width: calc(100vw - 2 * var(--margin));
    }
  }

  /* Chapters ------------------------------------------------------------- */
  .chapters {
    counter-reset: chapter;
  }

  .chapters :global(.chapter) {
    counter-increment: chapter;
  }

  .chapters :global(.chapter__n) {
    color: var(--signal);
    text-box: trim-both cap alphabetic;
  }

  .chapters :global(.chapter__n)::before {
    content: counter(chapter, decimal-leading-zero);
  }

  /* Next case study band ---------------------------------------------- */
  .next {
    position: relative;
    display: block;
    margin-top: var(--space-section);
    background: var(--tone);
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  .next--dark {
    color: var(--paper);
  }

  /* Background layer: real cover media (with a flat scrim for legibility) or the
     placeholder cover pattern. Scales slightly on hover. */
  .next__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform 1.4s var(--ease-out);
  }

  .next:hover .next__bg {
    transform: scale(1.03);
  }

  .next__bg :global(img),
  .next__bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .next--media .next__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(17 17 17 / 0.72);
  }

  .next__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center;
    mask-image: radial-gradient(ellipse at 60% 40%, #000 25%, transparent 85%);
  }

  /* One block anchored bottom-left: label → title → tagline. */
  .next__inner {
    position: relative;
    min-height: clamp(440px, 76vh, 800px);
    align-content: end;
    padding-block: var(--space-6);
    pointer-events: none;
  }

  .next__label {
    grid-column: 1 / -1;
  }

  .next__title {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    margin-left: -0.05em;
    font-size: var(--fs-mega);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.06em;
    text-wrap: balance;
    transition: transform 0.9s var(--ease-out);
  }

  .next:hover .next__title {
    transform: translateX(var(--space-3));
  }

  .next__tagline {
    grid-column: 1 / span 6;
    margin-top: var(--space-4);
    max-width: 40ch;
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.012em;
    opacity: 0.8;
  }

  /* The band already separates the page from the footer */
  :global(main:has(.next) + .footer .footer__contact)::before {
    display: none;
  }

  :global(main:has(.next) + .footer .footer__contact) {
    padding-top: 0;
  }

  @media (max-width: 960px) {
    .next__tagline {
      grid-column: 1 / -1;
    }
  }
</style>
